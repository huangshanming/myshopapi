syntax = "v1"

type PageReq {
	Page     int `form:"page,default=1"`
	PageSize int `form:"page_size,default=10"`
}

type IdPathReq {
	Id uint64 `path:"id"`
}

type FilePathReq {
	File string `path:"file"`
}

type CodePathReq {
	Code string `path:"code"`
}

type EmptyResp {}

type PageListResp {
	Total int64       `json:"total"`
	List  interface{} `json:"list"`
}

type AnyResp {
	Data interface{} `json:"data,optional"`
}

type DataResp {
	Data interface{} `json:"data,optional"`
}

type ThemePackageResp {
	Data interface{} `json:"data,optional"`
}

type SlotPackageResp {
	Data interface{} `json:"data,optional"`
}

type SeckillRuleResp {
	Data interface{} `json:"data,optional"`
}

type CouponStatsResp {
	Data interface{} `json:"data,optional"`
}

type CouponGrantResp {
	Data interface{} `json:"data,optional"`
}

type CouponResp {
	Data interface{} `json:"data,optional"`
}

type ThemeOrderResp {
	Data interface{} `json:"data,optional"`
}

type HomepageOrderResp {
	Data interface{} `json:"data,optional"`
}

type WalletResp {
	Data interface{} `json:"data,optional"`
}

type ShopApplicationResp {
	Data interface{} `json:"data,optional"`
}

type UserCouponResp {
	Data interface{} `json:"data,optional"`
}

type SeckillConsumeResp {
	Data interface{} `json:"data,optional"`
}

type MatchCouponsResp {
	Data interface{} `json:"data,optional"`
}

type SeckillSessionsResp {
	Data interface{} `json:"data,optional"`
}

type SeckillEntryResp {
	Data interface{} `json:"data,optional"`
}

type SeckillCurrentResp {
	Data interface{} `json:"data,optional"`
}

type HomeSlotsResp {
	Data interface{} `json:"data,optional"`
}

type ShopListResp {
	Data interface{} `json:"data,optional"`
}

type ShopResp {
	Data interface{} `json:"data,optional"`
}

type GrantedCountResp {
	Granted int64 `json:"granted"`
}

type ListResp {
	List interface{} `json:"list"`
}


type IdPageReq {
	Id       uint64 `path:"id"`
	Page     int    `form:"page,default=1"`
	PageSize int    `form:"page_size,default=10"`
}
type StatusPageReq {
	Page     int    `form:"page,default=1"`
	PageSize int    `form:"page_size,default=10"`
	Status   string `form:"status,optional"`
}
type CouponListReq {
	Page     int    `form:"page,default=1"`
	PageSize int    `form:"page_size,default=10"`
	Status   string `form:"status,optional"`
	Keyword  string `form:"keyword,optional"`
}
type SlotTypePageReq {
	Page     int    `form:"page,default=1"`
	PageSize int    `form:"page_size,default=10"`
	SlotType string `form:"slot_type,optional"`
}
type SlotOrderListReq {
	Page     int    `form:"page,default=1"`
	PageSize int    `form:"page_size,default=10"`
	ShopId   uint64 `form:"shop_id,optional"`
	SlotType string `form:"slot_type,optional"`
	Status   string `form:"status,optional"`
}
type ThemePackageListReq {
	Page        int    `form:"page,default=1"`
	PageSize    int    `form:"page_size,default=10"`
	ThemeSlotId uint64 `form:"theme_slot_id,optional"`
}
type ThemeOrderListReq {
	Page        int    `form:"page,default=1"`
	PageSize    int    `form:"page_size,default=10"`
	ShopId      uint64 `form:"shop_id,optional"`
	ThemeSlotId uint64 `form:"theme_slot_id,optional"`
}
type ShopListReq {
	Page     int    `form:"page,default=1"`
	PageSize int    `form:"page_size,default=10"`
	Status   string `form:"status,optional"`
	Name     string `form:"name,optional"`
}
type SeckillEntryListReq {
	Page      int    `form:"page,default=1"`
	PageSize  int    `form:"page_size,default=10"`
	SessionId uint64 `form:"session_id,optional"`
}


type SlotTypeQueryReq {
	SlotType string `form:"slot_type,optional"`
}
type ShopIdQueryReq {
	ShopId uint64 `form:"shop_id,optional"`
}

type ApplyReq {
	ShopName          string `json:"shop_name"`
	ContactName       string `json:"contact_name"`
	ContactPhone      string `json:"contact_phone"`
	Description       string `json:"description"`
	Category          string `json:"category"`
	Province          string `json:"province"`
	City              string `json:"city"`
	District          string `json:"district"`
	Address           string `json:"address"`
	BusinessLicenseNo string `json:"business_license_no"`
	LegalPerson       string `json:"legal_person"`
	LicenseImage      string `json:"license_image"`
	StorefrontImage   string `json:"storefront_image"`
}

type UpdateShopBodyReq {
	Id              uint64 `path:"id"`
	Name            string `json:"name"`
	Logo            string `json:"logo"`
	ContactName     string `json:"contact_name"`
	ContactPhone    string `json:"contact_phone"`
	Description     string `json:"description"`
	Category        string `json:"category"`
	Province        string `json:"province"`
	City            string `json:"city"`
	District        string `json:"district"`
	Address         string `json:"address"`
	StorefrontImage string `json:"storefront_image"`
}

type AdminCreateShopReq {
	Name              string `json:"name"`
	Logo              string `json:"logo"`
	ContactName       string `json:"contact_name"`
	ContactPhone      string `json:"contact_phone"`
	Description       string `json:"description"`
	Category          string `json:"category"`
	Province          string `json:"province"`
	City              string `json:"city"`
	District          string `json:"district"`
	Address           string `json:"address"`
	BusinessLicenseNo string `json:"business_license_no"`
	LegalPerson       string `json:"legal_person"`
	LicenseImage      string `json:"license_image"`
	StorefrontImage   string `json:"storefront_image"`
	OwnerMobile       string `json:"owner_mobile"`
	OwnerPassword     string `json:"owner_password"`
	OwnerNickname     string `json:"owner_nickname"`
}

type AdminUpdateShopBodyReq {
	Id                uint64 `path:"id"`
	Name              string `json:"name"`
	Logo              string `json:"logo"`
	ContactName       string `json:"contact_name"`
	ContactPhone      string `json:"contact_phone"`
	Description       string `json:"description"`
	Category          string `json:"category"`
	Province          string `json:"province"`
	City              string `json:"city"`
	District          string `json:"district"`
	Address           string `json:"address"`
	BusinessLicenseNo string `json:"business_license_no"`
	LegalPerson       string `json:"legal_person"`
	LicenseImage      string `json:"license_image"`
	StorefrontImage   string `json:"storefront_image"`
}

type OwnerPasswordBodyReq {
	Id       uint64 `path:"id"`
	Password string `json:"password"`
}

type RejectBodyReq {
	Id     uint64 `path:"id"`
	Reason string `json:"reason"`
}

type WalletAdjustBodyReq {
	Id     uint64  `path:"id"`
	Field  string  `json:"field"`
	Amount float64 `json:"amount"`
	Remark string  `json:"remark"`
}

type SeckillRuleReq {
	DurationHours     int     `json:"duration_hours"`
	ApplyFee          float64 `json:"apply_fee"`
	MaxEntriesPerShop int     `json:"max_entries_per_shop"`
	Status            int8    `json:"status"`
}

type SeckillApplyReq {
	SessionID    uint64  `json:"session_id"`
	ProductID    uint64  `json:"product_id"`
	ProductName  string  `json:"product_name"`
	ProductImage string  `json:"product_image"`
	OriginPrice  float64 `json:"origin_price"`
	SeckillPrice float64 `json:"seckill_price"`
	SeckillStock int     `json:"seckill_stock"`
	AutoRenew    int8    `json:"auto_renew,optional"`
}

type SeckillAutoRenewBodyReq {
	Id        uint64 `path:"id"`
	AutoRenew int8   `json:"auto_renew"`
}

type SeckillConsumeReq {
	EntryID   uint64 `json:"entry_id"`
	ProductID uint64 `json:"product_id"`
	Quantity  int    `json:"quantity"`
}

type SeckillRestoreReq {
	EntryID  uint64 `json:"entry_id"`
	Quantity int    `json:"quantity"`
}

type BuySlotReq {
	PackageID uint64 `json:"package_id"`
	TargetID  uint64 `json:"target_id,optional"`
}

type GrantSlotReq {
	ShopID    uint64 `json:"shop_id"`
	PackageID uint64 `json:"package_id"`
	TargetID  uint64 `json:"target_id,optional"`
}

type ThemeBuyReq {
	ThemeSlotID uint64 `json:"theme_slot_id"`
	PackageID   uint64 `json:"package_id"`
	Title       string `json:"title"`
	Subtitle    string `json:"subtitle,optional"`
	CoverURL    string `json:"cover_url"`
	LinkType    string `json:"link_type"`
	LinkID      uint64 `json:"link_id,optional"`
}

type ThemeGrantReq {
	ShopID      uint64 `json:"shop_id"`
	ThemeSlotID uint64 `json:"theme_slot_id"`
	PackageID   uint64 `json:"package_id"`
	Title       string `json:"title"`
	Subtitle    string `json:"subtitle,optional"`
	CoverURL    string `json:"cover_url"`
	LinkType    string `json:"link_type"`
	LinkID      uint64 `json:"link_id,optional"`
}

type SlotPackageSaveReq {
	SlotType     string  `json:"slot_type"`
	Name         string  `json:"name"`
	Price        float64 `json:"price"`
	DurationDays int     `json:"duration_days"`
	Status       string  `json:"status,optional"`
	Sort         int     `json:"sort,optional"`
	Remark       string  `json:"remark,optional"`
}

type SlotPackageUpdateBodyReq {
	Id           uint64  `path:"id"`
	SlotType     string  `json:"slot_type"`
	Name         string  `json:"name"`
	Price        float64 `json:"price"`
	DurationDays int     `json:"duration_days"`
	Status       string  `json:"status,optional"`
	Sort         int     `json:"sort,optional"`
	Remark       string  `json:"remark,optional"`
}

type SlotSettingItem {
	SlotType  string `json:"slot_type"`
	HomeLimit int    `json:"home_limit"`
}

type UpdateSlotSettingsReq {
	Items []SlotSettingItem `json:"items"`
}

type ThemePackageSaveReq {
	ThemeSlotID  uint64  `json:"theme_slot_id,optional"`
	Name         string  `json:"name"`
	Price        float64 `json:"price"`
	DurationDays int     `json:"duration_days"`
	Status       string  `json:"status,optional"`
	Sort         int     `json:"sort,optional"`
	Remark       string  `json:"remark,optional"`
}

type ThemePackageUpdateBodyReq {
	Id           uint64  `path:"id"`
	ThemeSlotID  uint64  `json:"theme_slot_id,optional"`
	Name         string  `json:"name"`
	Price        float64 `json:"price"`
	DurationDays int     `json:"duration_days"`
	Status       string  `json:"status,optional"`
	Sort         int     `json:"sort,optional"`
	Remark       string  `json:"remark,optional"`
}

type ThemeSlotUpdateBodyReq {
	Id              uint64 `path:"id"`
	Name            string `json:"name,optional"`
	Desc            string `json:"desc,optional"`
	CoverURL        string `json:"cover_url,optional"`
	DefaultLinkType string `json:"default_link_type,optional"`
	DefaultLinkID   uint64 `json:"default_link_id,optional"`
	Status          string `json:"status,optional"`
	Sort            int    `json:"sort,optional"`
	Position        string `json:"position,optional"`
}

type CouponScopeItem {
	RefType string `json:"ref_type"`
	RefID   uint64 `json:"ref_id"`
}

type CouponSaveReq {
	Name              string            `json:"name"`
	CouponType        string            `json:"coupon_type"`
	ThresholdAmount   float64           `json:"threshold_amount,optional"`
	DiscountAmount    float64           `json:"discount_amount,optional"`
	DiscountRate      float64           `json:"discount_rate,optional"`
	MaxDiscountAmount float64           `json:"max_discount_amount,optional"`
	ScopeType         string            `json:"scope_type,optional"`
	TotalCount        int               `json:"total_count,optional"`
	PerUserLimit      int               `json:"per_user_limit,optional"`
	ValidType         string            `json:"valid_type,optional"`
	ValidDays         int               `json:"valid_days,optional"`
	UserIdentity      string            `json:"user_identity,optional"`
	Channels          []string          `json:"channels,optional"`
	Status            string            `json:"status,optional"`
	Remark            string            `json:"remark,optional"`
	Scopes            []CouponScopeItem `json:"scopes,optional"`
}

type CouponUpdateBodyReq {
	Id                uint64            `path:"id"`
	Name              string            `json:"name"`
	CouponType        string            `json:"coupon_type"`
	ThresholdAmount   float64           `json:"threshold_amount,optional"`
	DiscountAmount    float64           `json:"discount_amount,optional"`
	DiscountRate      float64           `json:"discount_rate,optional"`
	MaxDiscountAmount float64           `json:"max_discount_amount,optional"`
	ScopeType         string            `json:"scope_type,optional"`
	TotalCount        int               `json:"total_count,optional"`
	PerUserLimit      int               `json:"per_user_limit,optional"`
	ValidType         string            `json:"valid_type,optional"`
	ValidDays         int               `json:"valid_days,optional"`
	UserIdentity      string            `json:"user_identity,optional"`
	Channels          []string          `json:"channels,optional"`
	Status            string            `json:"status,optional"`
	Remark            string            `json:"remark,optional"`
	Scopes            []CouponScopeItem `json:"scopes,optional"`
}

type GrantCouponReq {
	CouponID uint64   `json:"coupon_id"`
	UserIDs  []uint64 `json:"user_ids"`
}

type ClaimCouponBodyReq {
	Id     uint64 `path:"id"`
	Source string `json:"source,optional"`
}

type MatchItem {
	ProductID      uint64  `json:"product_id"`
	CategoryID     uint64  `json:"category_id,optional"`
	Amount         float64 `json:"amount"`
	SeckillEntryID uint64  `json:"seckill_entry_id,optional"`
}

type MatchCouponsReq {
	UserID       uint64      `json:"user_id"`
	ShopID       uint64      `json:"shop_id"`
	Items        []MatchItem `json:"items"`
	UserCouponID uint64      `json:"user_coupon_id,optional"`
}

type LockCouponReq {
	UserCouponID   uint64  `json:"user_coupon_id"`
	UserID         uint64  `json:"user_id"`
	OrderID        uint64  `json:"order_id"`
	DiscountAmount float64 `json:"discount_amount"`
}

type UnlockCouponReq {
	UserCouponID uint64 `json:"user_coupon_id"`
	OrderID      uint64 `json:"order_id"`
}

type RedeemCouponReq {
	UserCouponID   uint64  `json:"user_coupon_id"`
	OrderID        uint64  `json:"order_id"`
	DiscountAmount float64 `json:"discount_amount"`
}

type ReturnCouponReq {
	UserCouponID uint64 `json:"user_coupon_id"`
	OrderID      uint64 `json:"order_id"`
}

type OrderGiftCouponReq {
	UserID uint64 `json:"user_id"`
	ShopID uint64 `json:"shop_id"`
}


// Route table SSOT for merchant-service.
// group: <role>/<module> → internal/handler/<role>/<module>/
// Keep in sync with internal/handler/routes.go; run: scripts/check-api-routes.sh merchant-service
@server (
	middleware: RequestID
	group:      public/health
)
service merchantapi {
	@handler Healthz
	get /healthz returns (EmptyResp)

	@handler Readyz
	get /readyz returns (EmptyResp)
}

@server (
	middleware: RequestID
	group:      public/shop
)
service merchantapi {
	@handler PublicListShops
	get /api/v1/shops/list (PageReq) returns (PageListResp)

	@handler PublicHomeSlots
	get /api/v1/shops/home-slots (SlotTypeQueryReq) returns (HomeSlotsResp)

	@handler PublicThemeTiles
	get /api/v1/home/theme-tiles returns (ListResp)

	@handler PublicGetShop
	get /api/v1/shops/:id (IdPathReq) returns (ShopResp)
}

@server (
	middleware: RequestID
	group:      public/seckill
)
service merchantapi {
	@handler PublicSeckillCurrent
	get /api/v1/seckill/current returns (SeckillCurrentResp)

	@handler PublicSeckillList
	get /api/v1/seckill/list (PageReq) returns (PageListResp)

	@handler PublicSeckillEntry
	get /api/v1/seckill/entries/:id (IdPathReq) returns (SeckillEntryResp)
}

@server (
	middleware: RequestID
	group:      public/coupon
)
service merchantapi {
	@handler PublicCouponCenter
	get /api/v1/coupons/center (ShopIdQueryReq) returns (ListResp)

	@handler PublicCouponPopup
	get /api/v1/coupons/popup returns (ListResp)
}

@server (
	middleware: RequestID
	group:      internalapi/seckill
)
service merchantapi {
	@handler SeckillConsume
	post /api/v1/seckill/consume (SeckillConsumeReq) returns (SeckillConsumeResp)

	@handler SeckillRestore
	post /api/v1/seckill/restore (SeckillRestoreReq) returns (EmptyResp)
}

@server (
	middleware: RequestID
	group:      internalapi/coupon
)
service merchantapi {
	@handler InternalMatchCoupons
	post /api/v1/internal/coupons/match (MatchCouponsReq) returns (MatchCouponsResp)

	@handler InternalLockCoupon
	post /api/v1/internal/coupons/lock (LockCouponReq) returns (EmptyResp)

	@handler InternalUnlockCoupon
	post /api/v1/internal/coupons/unlock (UnlockCouponReq) returns (EmptyResp)

	@handler InternalRedeemCoupon
	post /api/v1/internal/coupons/redeem (RedeemCouponReq) returns (EmptyResp)

	@handler InternalReturnCoupon
	post /api/v1/internal/coupons/return (ReturnCouponReq) returns (EmptyResp)

	@handler InternalOrderGift
	post /api/v1/internal/coupons/order-gift (OrderGiftCouponReq) returns (GrantedCountResp)
}

@server (
	middleware: RequestID,GatewayIdentity
	group:      user/coupon
)
service merchantapi {
	@handler ClaimCoupon
	post /api/v1/coupons/:id/claim (ClaimCouponBodyReq) returns (UserCouponResp)

	@handler ListMyCoupons
	get /api/v1/user/coupons (StatusPageReq) returns (PageListResp)
}

@server (
	middleware: RequestID,GatewayIdentity
	group:      merchant/shop
)
service merchantapi {
	@handler Apply
	post /api/v1/merchant/apply (ApplyReq) returns (ShopApplicationResp)

	@handler MyShops
	get /api/v1/merchant/shops returns (ShopListResp)
}

@server (
	middleware: RequestID,GatewayIdentity,RequireMerchantOwner
	group:      merchant/shop
)
service merchantapi {
	@handler UpdateMyShop
	put /api/v1/merchant/shops/:id (UpdateShopBodyReq) returns (EmptyResp)
}

@server (
	middleware: RequestID,GatewayIdentity,RequireMerchantOwner
	group:      merchant/wallet
)
service merchantapi {
	@handler MerchantGetWallet
	get /api/v1/merchant/wallet returns (WalletResp)

	@handler MerchantWalletLogs
	get /api/v1/merchant/wallet/logs (PageReq) returns (PageListResp)
}

@server (
	middleware: RequestID,GatewayIdentity,RequireMerchantOwner
	group:      merchant/seckill
)
service merchantapi {
	@handler MerchantSeckillSessions
	get /api/v1/merchant/seckill/sessions returns (SeckillSessionsResp)

	@handler MerchantApplySeckill
	post /api/v1/merchant/seckill/entries (SeckillApplyReq) returns (SeckillEntryResp)

	@handler MerchantListSeckillEntries
	get /api/v1/merchant/seckill/entries (PageReq) returns (PageListResp)

	@handler MerchantSetSeckillAutoRenew
	put /api/v1/merchant/seckill/entries/:id/auto-renew (SeckillAutoRenewBodyReq) returns (SeckillEntryResp)
}

@server (
	middleware: RequestID,GatewayIdentity,RequireMerchantOwner
	group:      merchant/homepage
)
service merchantapi {
	@handler MerchantListSlotPackages
	get /api/v1/merchant/homepage-packages (SlotTypePageReq) returns (PageListResp)

	@handler MerchantBuySlot
	post /api/v1/merchant/homepage-orders (BuySlotReq) returns (HomepageOrderResp)

	@handler MerchantListSlotOrders
	get /api/v1/merchant/homepage-orders (SlotOrderListReq) returns (PageListResp)
}

@server (
	middleware: RequestID,GatewayIdentity,RequireMerchantOwner
	group:      merchant/theme
)
service merchantapi {
	@handler MerchantListThemeSlots
	get /api/v1/merchant/theme-slots (PageReq) returns (PageListResp)

	@handler MerchantListThemePackages
	get /api/v1/merchant/theme-packages (ThemePackageListReq) returns (PageListResp)

	@handler MerchantBuyTheme
	post /api/v1/merchant/theme-orders (ThemeBuyReq) returns (ThemeOrderResp)

	@handler MerchantListThemeOrders
	get /api/v1/merchant/theme-orders (PageReq) returns (PageListResp)
}

@server (
	middleware: RequestID,GatewayIdentity,RequireMerchantOwner
	group:      merchant/coupon
)
service merchantapi {
	@handler MerchantListCoupons
	get /api/v1/merchant/coupons (CouponListReq) returns (PageListResp)

	@handler MerchantCreateCoupon
	post /api/v1/merchant/coupons (CouponSaveReq) returns (CouponResp)

	@handler MerchantUpdateCoupon
	put /api/v1/merchant/coupons/:id (CouponUpdateBodyReq) returns (EmptyResp)

	@handler MerchantOffCoupon
	put /api/v1/merchant/coupons/:id/off (IdPathReq) returns (EmptyResp)

	@handler MerchantCopyCoupon
	post /api/v1/merchant/coupons/:id/copy (IdPathReq) returns (CouponResp)

	@handler MerchantGrantCoupon
	post /api/v1/merchant/coupons/grant (GrantCouponReq) returns (CouponGrantResp)

	@handler MerchantCouponClaims
	get /api/v1/merchant/coupons/:id/claims (IdPageReq) returns (PageListResp)

	@handler MerchantCouponRedeems
	get /api/v1/merchant/coupons/:id/redeems (IdPageReq) returns (PageListResp)

	@handler MerchantCouponStats
	get /api/v1/merchant/coupons/:id/stats (IdPathReq) returns (CouponStatsResp)
}

@server (
	middleware: RequestID,GatewayIdentity,RequirePlatformAdmin
	group:      admin/application
)
service merchantapi {
	@handler AdminListApplications
	get /api/v1/admin/applications (StatusPageReq) returns (PageListResp)

	@handler AdminApprove
	post /api/v1/admin/applications/:id/approve (IdPathReq) returns (ShopResp)

	@handler AdminReject
	post /api/v1/admin/applications/:id/reject (RejectBodyReq) returns (EmptyResp)
}

@server (
	middleware: RequestID,GatewayIdentity,RequirePlatformAdmin
	group:      admin/shop
)
service merchantapi {
	@handler AdminListShops
	get /api/v1/admin/shops (ShopListReq) returns (PageListResp)

	@handler AdminCreateShop
	post /api/v1/admin/shops (AdminCreateShopReq) returns (ShopResp)

	@handler AdminGetShop
	get /api/v1/admin/shops/:id (IdPathReq) returns (ShopResp)

	@handler AdminUpdateShop
	put /api/v1/admin/shops/:id (AdminUpdateShopBodyReq) returns (EmptyResp)

	@handler AdminResetOwnerPassword
	put /api/v1/admin/shops/:id/owner-password (OwnerPasswordBodyReq) returns (EmptyResp)

	@handler AdminDisableShop
	put /api/v1/admin/shops/:id/disable (RejectBodyReq) returns (EmptyResp)

	@handler AdminEnableShop
	put /api/v1/admin/shops/:id/enable (IdPathReq) returns (EmptyResp)
}

@server (
	middleware: RequestID,GatewayIdentity,RequirePlatformAdmin
	group:      admin/wallet
)
service merchantapi {
	@handler AdminGetWallet
	get /api/v1/admin/shops/:id/wallet (IdPathReq) returns (WalletResp)

	@handler AdminAdjustWallet
	post /api/v1/admin/shops/:id/wallet/adjust (WalletAdjustBodyReq) returns (WalletResp)

	@handler AdminWalletLogs
	get /api/v1/admin/shops/:id/wallet/logs (IdPageReq) returns (PageListResp)
}

@server (
	middleware: RequestID,GatewayIdentity,RequirePlatformAdmin
	group:      admin/seckill
)
service merchantapi {
	@handler AdminGetSeckillRule
	get /api/v1/admin/seckill/rule returns (SeckillRuleResp)

	@handler AdminUpdateSeckillRule
	put /api/v1/admin/seckill/rule (SeckillRuleReq) returns (SeckillRuleResp)

	@handler AdminListSeckillSessions
	get /api/v1/admin/seckill/sessions (PageReq) returns (PageListResp)

	@handler AdminListSeckillEntries
	get /api/v1/admin/seckill/entries (SeckillEntryListReq) returns (PageListResp)
}

@server (
	middleware: RequestID,GatewayIdentity,RequirePlatformAdmin
	group:      admin/homepage
)
service merchantapi {
	@handler AdminListSlotPackages
	get /api/v1/admin/homepage-packages (SlotTypePageReq) returns (PageListResp)

	@handler AdminCreateSlotPackage
	post /api/v1/admin/homepage-packages (SlotPackageSaveReq) returns (SlotPackageResp)

	@handler AdminUpdateSlotPackage
	put /api/v1/admin/homepage-packages/:id (SlotPackageUpdateBodyReq) returns (EmptyResp)

	@handler AdminListSlotSettings
	get /api/v1/admin/homepage-settings (PageReq) returns (PageListResp)

	@handler AdminUpdateSlotSettings
	put /api/v1/admin/homepage-settings (UpdateSlotSettingsReq) returns (EmptyResp)

	@handler AdminListSlotOrders
	get /api/v1/admin/homepage-orders (SlotOrderListReq) returns (PageListResp)

	@handler AdminGrantSlot
	post /api/v1/admin/homepage-orders/grant (GrantSlotReq) returns (HomepageOrderResp)
}

@server (
	middleware: RequestID,GatewayIdentity,RequirePlatformAdmin
	group:      admin/theme
)
service merchantapi {
	@handler AdminListThemeSlots
	get /api/v1/admin/theme-slots (PageReq) returns (PageListResp)

	@handler AdminUpdateThemeSlot
	put /api/v1/admin/theme-slots/:id (ThemeSlotUpdateBodyReq) returns (EmptyResp)

	@handler AdminListThemePackages
	get /api/v1/admin/theme-packages (ThemePackageListReq) returns (PageListResp)

	@handler AdminCreateThemePackage
	post /api/v1/admin/theme-packages (ThemePackageSaveReq) returns (ThemePackageResp)

	@handler AdminUpdateThemePackage
	put /api/v1/admin/theme-packages/:id (ThemePackageUpdateBodyReq) returns (EmptyResp)

	@handler AdminListThemeOrders
	get /api/v1/admin/theme-orders (ThemeOrderListReq) returns (PageListResp)

	@handler AdminGrantTheme
	post /api/v1/admin/theme-orders/grant (ThemeGrantReq) returns (ThemeOrderResp)
}

@server (
	middleware: RequestID,GatewayIdentity,RequirePlatformAdmin
	group:      admin/coupon
)
service merchantapi {
	@handler AdminListCoupons
	get /api/v1/admin/coupons (CouponListReq) returns (PageListResp)

	@handler AdminCreateCoupon
	post /api/v1/admin/coupons (CouponSaveReq) returns (CouponResp)

	@handler AdminUpdateCoupon
	put /api/v1/admin/coupons/:id (CouponUpdateBodyReq) returns (EmptyResp)

	@handler AdminOffCoupon
	put /api/v1/admin/coupons/:id/off (IdPathReq) returns (EmptyResp)

	@handler AdminCopyCoupon
	post /api/v1/admin/coupons/:id/copy (IdPathReq) returns (CouponResp)

	@handler AdminGrantCoupon
	post /api/v1/admin/coupons/grant (GrantCouponReq) returns (CouponGrantResp)

	@handler AdminCouponClaims
	get /api/v1/admin/coupons/:id/claims (IdPageReq) returns (PageListResp)

	@handler AdminCouponRedeems
	get /api/v1/admin/coupons/:id/redeems (IdPageReq) returns (PageListResp)

	@handler AdminCouponStats
	get /api/v1/admin/coupons/:id/stats (IdPathReq) returns (CouponStatsResp)
}

