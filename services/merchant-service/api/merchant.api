syntax = "v1"

// Route table SSOT for merchant-service.
// group: <role>/<module> → internal/handler/<role>/<module>/
// Keep in sync with internal/handler/routes.go; run: scripts/check-api-routes.sh merchant-service
@server (
	middleware: RequestID
	group:      public/health
)
service merchantapi {
	@handler Healthz
	get /healthz

	@handler Readyz
	get /readyz
}

@server (
	middleware: RequestID
	group:      public/shop
)
service merchantapi {
	@handler PublicListShops
	get /api/v1/shops/list

	@handler PublicHomeSlots
	get /api/v1/shops/home-slots

	@handler PublicThemeTiles
	get /api/v1/home/theme-tiles

	@handler PublicGetShop
	get /api/v1/shops/:id
}

@server (
	middleware: RequestID
	group:      public/seckill
)
service merchantapi {
	@handler PublicSeckillCurrent
	get /api/v1/seckill/current

	@handler PublicSeckillList
	get /api/v1/seckill/list

	@handler PublicSeckillEntry
	get /api/v1/seckill/entries/:id
}

@server (
	middleware: RequestID
	group:      public/coupon
)
service merchantapi {
	@handler PublicCouponCenter
	get /api/v1/coupons/center

	@handler PublicCouponPopup
	get /api/v1/coupons/popup
}

@server (
	middleware: RequestID
	group:      internalapi/seckill
)
service merchantapi {
	@handler SeckillConsume
	post /api/v1/seckill/consume

	@handler SeckillRestore
	post /api/v1/seckill/restore
}

@server (
	middleware: RequestID
	group:      internalapi/coupon
)
service merchantapi {
	@handler InternalMatchCoupons
	post /api/v1/internal/coupons/match

	@handler InternalLockCoupon
	post /api/v1/internal/coupons/lock

	@handler InternalUnlockCoupon
	post /api/v1/internal/coupons/unlock

	@handler InternalRedeemCoupon
	post /api/v1/internal/coupons/redeem

	@handler InternalReturnCoupon
	post /api/v1/internal/coupons/return

	@handler InternalOrderGift
	post /api/v1/internal/coupons/order-gift
}

@server (
	middleware: RequestID,GatewayIdentity
	group:      user/coupon
)
service merchantapi {
	@handler ClaimCoupon
	post /api/v1/coupons/:id/claim

	@handler ListMyCoupons
	get /api/v1/user/coupons
}

@server (
	middleware: RequestID,GatewayIdentity
	group:      merchant/shop
)
service merchantapi {
	@handler Apply
	post /api/v1/merchant/apply

	@handler MyShops
	get /api/v1/merchant/shops
}

@server (
	middleware: RequestID,GatewayIdentity,RequireMerchantOwner
	group:      merchant/shop
)
service merchantapi {
	@handler UpdateMyShop
	put /api/v1/merchant/shops/:id
}

@server (
	middleware: RequestID,GatewayIdentity,RequireMerchantOwner
	group:      merchant/wallet
)
service merchantapi {
	@handler MerchantGetWallet
	get /api/v1/merchant/wallet

	@handler MerchantWalletLogs
	get /api/v1/merchant/wallet/logs
}

@server (
	middleware: RequestID,GatewayIdentity,RequireMerchantOwner
	group:      merchant/seckill
)
service merchantapi {
	@handler MerchantSeckillSessions
	get /api/v1/merchant/seckill/sessions

	@handler MerchantApplySeckill
	post /api/v1/merchant/seckill/entries

	@handler MerchantListSeckillEntries
	get /api/v1/merchant/seckill/entries

	@handler MerchantSetSeckillAutoRenew
	put /api/v1/merchant/seckill/entries/:id/auto-renew
}

@server (
	middleware: RequestID,GatewayIdentity,RequireMerchantOwner
	group:      merchant/homepage
)
service merchantapi {
	@handler MerchantListSlotPackages
	get /api/v1/merchant/homepage-packages

	@handler MerchantBuySlot
	post /api/v1/merchant/homepage-orders

	@handler MerchantListSlotOrders
	get /api/v1/merchant/homepage-orders
}

@server (
	middleware: RequestID,GatewayIdentity,RequireMerchantOwner
	group:      merchant/theme
)
service merchantapi {
	@handler MerchantListThemeSlots
	get /api/v1/merchant/theme-slots

	@handler MerchantListThemePackages
	get /api/v1/merchant/theme-packages

	@handler MerchantBuyTheme
	post /api/v1/merchant/theme-orders

	@handler MerchantListThemeOrders
	get /api/v1/merchant/theme-orders
}

@server (
	middleware: RequestID,GatewayIdentity,RequireMerchantOwner
	group:      merchant/coupon
)
service merchantapi {
	@handler MerchantListCoupons
	get /api/v1/merchant/coupons

	@handler MerchantCreateCoupon
	post /api/v1/merchant/coupons

	@handler MerchantUpdateCoupon
	put /api/v1/merchant/coupons/:id

	@handler MerchantOffCoupon
	put /api/v1/merchant/coupons/:id/off

	@handler MerchantCopyCoupon
	post /api/v1/merchant/coupons/:id/copy

	@handler MerchantGrantCoupon
	post /api/v1/merchant/coupons/grant

	@handler MerchantCouponClaims
	get /api/v1/merchant/coupons/:id/claims

	@handler MerchantCouponRedeems
	get /api/v1/merchant/coupons/:id/redeems

	@handler MerchantCouponStats
	get /api/v1/merchant/coupons/:id/stats
}

@server (
	middleware: RequestID,GatewayIdentity,RequirePlatformAdmin
	group:      admin/application
)
service merchantapi {
	@handler AdminListApplications
	get /api/v1/admin/applications

	@handler AdminApprove
	post /api/v1/admin/applications/:id/approve

	@handler AdminReject
	post /api/v1/admin/applications/:id/reject
}

@server (
	middleware: RequestID,GatewayIdentity,RequirePlatformAdmin
	group:      admin/shop
)
service merchantapi {
	@handler AdminListShops
	get /api/v1/admin/shops

	@handler AdminCreateShop
	post /api/v1/admin/shops

	@handler AdminGetShop
	get /api/v1/admin/shops/:id

	@handler AdminUpdateShop
	put /api/v1/admin/shops/:id

	@handler AdminResetOwnerPassword
	put /api/v1/admin/shops/:id/owner-password

	@handler AdminDisableShop
	put /api/v1/admin/shops/:id/disable

	@handler AdminEnableShop
	put /api/v1/admin/shops/:id/enable
}

@server (
	middleware: RequestID,GatewayIdentity,RequirePlatformAdmin
	group:      admin/wallet
)
service merchantapi {
	@handler AdminGetWallet
	get /api/v1/admin/shops/:id/wallet

	@handler AdminAdjustWallet
	post /api/v1/admin/shops/:id/wallet/adjust

	@handler AdminWalletLogs
	get /api/v1/admin/shops/:id/wallet/logs
}

@server (
	middleware: RequestID,GatewayIdentity,RequirePlatformAdmin
	group:      admin/seckill
)
service merchantapi {
	@handler AdminGetSeckillRule
	get /api/v1/admin/seckill/rule

	@handler AdminUpdateSeckillRule
	put /api/v1/admin/seckill/rule

	@handler AdminListSeckillSessions
	get /api/v1/admin/seckill/sessions

	@handler AdminListSeckillEntries
	get /api/v1/admin/seckill/entries
}

@server (
	middleware: RequestID,GatewayIdentity,RequirePlatformAdmin
	group:      admin/homepage
)
service merchantapi {
	@handler AdminListSlotPackages
	get /api/v1/admin/homepage-packages

	@handler AdminCreateSlotPackage
	post /api/v1/admin/homepage-packages

	@handler AdminUpdateSlotPackage
	put /api/v1/admin/homepage-packages/:id

	@handler AdminListSlotSettings
	get /api/v1/admin/homepage-settings

	@handler AdminUpdateSlotSettings
	put /api/v1/admin/homepage-settings

	@handler AdminListSlotOrders
	get /api/v1/admin/homepage-orders

	@handler AdminGrantSlot
	post /api/v1/admin/homepage-orders/grant
}

@server (
	middleware: RequestID,GatewayIdentity,RequirePlatformAdmin
	group:      admin/theme
)
service merchantapi {
	@handler AdminListThemeSlots
	get /api/v1/admin/theme-slots

	@handler AdminUpdateThemeSlot
	put /api/v1/admin/theme-slots/:id

	@handler AdminListThemePackages
	get /api/v1/admin/theme-packages

	@handler AdminCreateThemePackage
	post /api/v1/admin/theme-packages

	@handler AdminUpdateThemePackage
	put /api/v1/admin/theme-packages/:id

	@handler AdminListThemeOrders
	get /api/v1/admin/theme-orders

	@handler AdminGrantTheme
	post /api/v1/admin/theme-orders/grant
}

@server (
	middleware: RequestID,GatewayIdentity,RequirePlatformAdmin
	group:      admin/coupon
)
service merchantapi {
	@handler AdminListCoupons
	get /api/v1/admin/coupons

	@handler AdminCreateCoupon
	post /api/v1/admin/coupons

	@handler AdminUpdateCoupon
	put /api/v1/admin/coupons/:id

	@handler AdminOffCoupon
	put /api/v1/admin/coupons/:id/off

	@handler AdminCopyCoupon
	post /api/v1/admin/coupons/:id/copy

	@handler AdminGrantCoupon
	post /api/v1/admin/coupons/grant

	@handler AdminCouponClaims
	get /api/v1/admin/coupons/:id/claims

	@handler AdminCouponRedeems
	get /api/v1/admin/coupons/:id/redeems

	@handler AdminCouponStats
	get /api/v1/admin/coupons/:id/stats
}

