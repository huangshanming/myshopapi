syntax = "v1"

type PageReq {
	Page     int `form:"page,default=1"`
	PageSize int `form:"page_size,default=10"`
}

type IdPathReq {
	Id uint64 `path:"id"`
}

type FilePathReq {
	File string `path:"file"`
}

type CodePathReq {
	Code string `path:"code"`
}

type EmptyResp {}

type PageListResp {
	Total int64       `json:"total"`
	List  interface{} `json:"list"`
}

type AnyResp {
	Data interface{} `json:"data,optional"`
}

type JSONBody {}

// Route table SSOT for catalog-service.
// Keep in sync with internal/handler/routes.go; run: scripts/check-api-routes.sh catalog-service
// group: <role>/<module> → internal/handler/<role>/<module>/
@server (
	middleware: RequestID
	group:      public/health
)
service catalogapi {
	@handler Healthz
	get /healthz returns (EmptyResp)

	@handler Readyz
	get /readyz returns (EmptyResp)

	@handler Metrics
	get /metrics
}

@server (
	middleware: RequestID
	group:      public/product
)
service catalogapi {
	@handler GetProductList
	get /api/v1/products/list (PageReq) returns (PageListResp)

	@handler GetProductDetail
	get /api/v1/products/detail returns (AnyResp)

	@handler GetSalesRank
	get /api/v1/products/sales-rank returns (AnyResp)

	@handler Count
	get /api/v1/products/:id/favorite-count (IdPathReq) returns (AnyResp)
}

@server (
	middleware: RequestID
	group:      public/category
)
service catalogapi {
	@handler GetCategoryList
	get /api/v1/product_category/list (PageReq) returns (PageListResp)

	@handler GetCategoryDetail
	get /api/v1/product_category/detail returns (AnyResp)
}

@server (
	middleware: RequestID
	group:      public/banner
)
service catalogapi {
	@handler ListBanners
	get /api/v1/banners (PageReq) returns (PageListResp)
}

@server (
	middleware: RequestID
	group:      public/article
)
service catalogapi {
	@handler PublicListArticles
	get /api/v1/articles/list (PageReq) returns (PageListResp)

	@handler PublicGetArticle
	get /api/v1/articles/:id (IdPathReq) returns (AnyResp)

	@handler ListComments
	get /api/v1/articles/:id/comments (IdPathReq) returns (PageListResp)

	@handler ListEmojis
	get /api/v1/comment-emojis (PageReq) returns (PageListResp)
}

@server (
	middleware: RequestID,GatewayIdentity
	group:      user/article
)
service catalogapi {
	@handler CreateComment
	post /api/v1/articles/:id/comments (IdPathReq) returns (AnyResp)

	@handler Like
	post /api/v1/articles/:id/like (IdPathReq) returns (AnyResp)

	@handler Unlike
	delete /api/v1/articles/:id/like (IdPathReq) returns (AnyResp)

	@handler Favorite
	post /api/v1/articles/:id/favorite (IdPathReq) returns (AnyResp)

	@handler Unfavorite
	delete /api/v1/articles/:id/favorite (IdPathReq) returns (AnyResp)

	@handler UserArticleEngagement
	get /api/v1/articles/:id/engagement (IdPathReq) returns (AnyResp)

	@handler ListMyFavorites
	get /api/v1/user/article-favorites (PageReq) returns (PageListResp)

	@handler ListMyLikes
	get /api/v1/user/article-likes (PageReq) returns (PageListResp)

	@handler ListMine
	get /api/v1/user/articles (PageReq) returns (PageListResp)

	@handler CreateMine
	post /api/v1/user/articles (JSONBody) returns (AnyResp)

	@handler DetailMine
	get /api/v1/user/articles/:id (IdPathReq) returns (AnyResp)

	@handler UpdateMine
	put /api/v1/user/articles/:id (IdPathReq) returns (AnyResp)

	@handler DeleteMine
	delete /api/v1/user/articles/:id (IdPathReq) returns (AnyResp)

	@handler UploadMine
	post /api/v1/user/article-uploads (JSONBody) returns (AnyResp)
}

@server (
	middleware: RequestID,GatewayIdentity
	group:      user/favorite
)
service catalogapi {
	@handler UserAddFavorite
	post /api/v1/user/favorites (JSONBody) returns (AnyResp)

	@handler UserRemoveFavorite
	delete /api/v1/user/favorites/:product_id returns (AnyResp)

	@handler RemoveBatch
	post /api/v1/user/favorites/batch-remove (JSONBody) returns (AnyResp)

	@handler UserListFavorites
	get /api/v1/user/favorites (PageReq) returns (PageListResp)

	@handler UserFavoriteStatus
	get /api/v1/products/:id/favorite (IdPathReq) returns (AnyResp)
}

@server (
