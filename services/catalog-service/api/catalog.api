syntax = "v1"

type PageReq {
	Page     int `form:"page,default=1"`
	PageSize int `form:"page_size,default=10"`
}

type IdPathReq {
	Id uint64 `path:"id"`
}

type FilePathReq {
	File string `path:"file"`
}

type CodePathReq {
	Code string `path:"code"`
}

type EmptyResp {}

type URLResp {
	Url string `json:"url"`
}

type CountResp {
	Count int64 `json:"count"`
}

type FavoriteStatusResp {
	Favorited bool `json:"favorited"`
}

type EngagementResp {
	Liked bool `json:"liked"`
	Favorited bool `json:"favorited"`
}


type PageListResp {
	Total int64       `json:"total"`
	List  interface{} `json:"list"`
}

type AnyResp {
	Data interface{} `json:"data,optional"`
}

type DataResp {
	Data interface{} `json:"data,optional"`
}

type RoleMenuIdsResp {
	Data interface{} `json:"data,optional"`
}

type SalesRankResp {
	Data interface{} `json:"data,optional"`
}

type ArticleStatsResp {
	Data interface{} `json:"data,optional"`
}

type EmojiResp {
	Data interface{} `json:"data,optional"`
}

type BannerResp {
	Data interface{} `json:"data,optional"`
}

type ShopRoleResp {
	Data interface{} `json:"data,optional"`
}

type AttrTemplateResp {
	Data interface{} `json:"data,optional"`
}

type TagResp {
	Data interface{} `json:"data,optional"`
}

type StockWarningsResp {
	Data interface{} `json:"data,optional"`
}

type ImportResultResp {
	Data interface{} `json:"data,optional"`
}

type ProductJobResp {
	Data interface{} `json:"data,optional"`
}

type CommentResp {
	Data interface{} `json:"data,optional"`
}

type ArticleResp {
	Data interface{} `json:"data,optional"`
}

type CategoryResp {
	Data interface{} `json:"data,optional"`
}

type ProductResp {
	Data interface{} `json:"data,optional"`
}

type BindStaffResp {
	UserId uint64 `json:"user_id"`
	Msg string `json:"msg"`
}

type ShopAuthMeResp {
	Perms interface{} `json:"perms"`
	Menus interface{} `json:"menus"`
	MenuTree interface{} `json:"menu_tree"`
	IsOwner bool `json:"is_owner"`
}


type IdPageReq {
	Id       uint64 `path:"id"`
	Page     int    `form:"page,default=1"`
	PageSize int    `form:"page_size,default=10"`
}
type PublicProductListReq {
	Page       int    `form:"page,default=1"`
	PageSize   int    `form:"page_size,default=10"`
	ShopId     uint64 `form:"shop_id,optional"`
	CategoryId uint64 `form:"category_id,optional"`
	OrderBy    string `form:"order_by,optional"`
}
type PublicArticleListReq {
	Page     int    `form:"page,default=1"`
	PageSize int    `form:"page_size,default=10"`
	Home     string `form:"home,optional"`
}
type MerchantProductListReq {
	Page        int    `form:"page,default=1"`
	PageSize    int    `form:"page_size,default=10"`
	Name        string `form:"name,optional"`
	ProductNo   string `form:"product_no,optional"`
	CategoryId  uint64 `form:"category_id,optional"`
	Status      string `form:"status,optional"`
	ProductType string `form:"product_type,optional"`
	StockWarn   string `form:"stock_warn,optional"`
	OrderBy     string `form:"order_by,optional"`
	Recycle     string `form:"recycle,optional"`
}
type AdminProductListReq {
	Page        int    `form:"page,default=1"`
	PageSize    int    `form:"page_size,default=10"`
	ShopId      uint64 `form:"shop_id,optional"`
	Name        string `form:"name,optional"`
	ProductNo   string `form:"product_no,optional"`
	CategoryId  uint64 `form:"category_id,optional"`
	Status      string `form:"status,optional"`
	ProductType string `form:"product_type,optional"`
	OrderBy     string `form:"order_by,optional"`
	CreatedFrom string `form:"created_from,optional"`
	CreatedTo   string `form:"created_to,optional"`
	PublishFrom string `form:"publish_from,optional"`
	PublishTo   string `form:"publish_to,optional"`
}
type MerchantArticleListReq {
	Page        int    `form:"page,default=1"`
	PageSize    int    `form:"page_size,default=10"`
	Title       string `form:"title,optional"`
	AuditStatus string `form:"audit_status,optional"`
	Status      string `form:"status,optional"`
}
type AdminArticleListReq {
	Page        int    `form:"page,default=1"`
	PageSize    int    `form:"page_size,default=10"`
	Title       string `form:"title,optional"`
	AuditStatus string `form:"audit_status,optional"`
	Status      string `form:"status,optional"`
	ShopId      uint64 `form:"shop_id,optional"`
	HasSchedule string `form:"has_schedule,optional"`
	CreatedFrom string `form:"created_from,optional"`
	CreatedTo   string `form:"created_to,optional"`
}
type ArticleCommentListReq {
	Page      int    `form:"page,default=1"`
	PageSize  int    `form:"page_size,default=10"`
	ArticleId uint64 `form:"article_id,optional"`
	ShopId    uint64 `form:"shop_id,optional"`
	Status    string `form:"status,optional"`
}
type NotificationListReq {
	Page     int    `form:"page,default=1"`
	PageSize int    `form:"page_size,default=10"`
	IsRead   string `form:"is_read,optional"`
}
type OpLogsReq {
	Page      int    `form:"page,default=1"`
	PageSize  int    `form:"page_size,default=10"`
	ProductId uint64 `form:"product_id,optional"`
}


type ProductUpdateBodyReq {
	Id          uint64 `path:"id"`
	Name        string `json:"name"`
	CategoryId  uint64 `json:"category_id,optional"`
	ProductType string `json:"product_type,optional"`
	Status      string `json:"status,optional"`
}
type SetStatusBodyReq {
	Id     uint64 `path:"id"`
	Status string `json:"status"`
}
type TagUpdateBodyReq {
	Id    uint64 `path:"id"`
	Name  string `json:"name"`
	Color string `json:"color,optional"`
}
type AttrTemplateUpdateBodyReq {
	Id        uint64 `path:"id"`
	Name      string `json:"name"`
	AttrsJSON string `json:"attrs_json,optional"`
}
type StockAdjustBodyReq {
	Id    uint64 `path:"id"`
	SkuID uint64 `json:"sku_id"`
}
type ScheduleBodyReq {
	Id     uint64 `path:"id"`
	Action string `json:"action"`
	RunAt  string `json:"run_at"`
}
type ShopRoleUpdateBodyReq {
	Id   uint64 `path:"id"`
	Code string `json:"code"`
	Name string `json:"name"`
}
type ArticleUpdateBodyReq {
	Id    uint64 `path:"id"`
	Title string `json:"title"`
}
type ArticleCommentPatchBodyReq {
	Id     uint64 `path:"id"`
	Status string `json:"status"`
}
type ArticleCategoryUpdateBodyReq {
	Id   uint64 `path:"id"`
	Name string `json:"name"`
}
type ArticleTopBodyReq {
	Id    uint64 `path:"id"`
	IsTop int8   `json:"is_top"`
}
type ArticleRemarkBodyReq {
	Id     uint64 `path:"id"`
	Remark string `json:"remark,optional"`
}
type ArticleAuditBodyReq {
	Id   uint64 `path:"id"`
	Pass bool   `json:"pass"`
}
type UserArticleUpdateBodyReq {
	Id    uint64 `path:"id"`
	Title string `json:"title"`
}
type CreateCommentBodyReq {
	Id      uint64 `path:"id"`
	Content string `json:"content"`
}
type BannerUpdateBodyReq {
	Id       uint64 `path:"id"`
	ImageURL string `json:"image_url"`
}
type PlatformProductRemarkBodyReq {
	Id     uint64 `path:"id"`
	Remark string `json:"remark,optional"`
}
type CategoryUpdateBodyReq {
	Id   uint64 `path:"id"`
	Name string `json:"name"`
}
type EmojiUpdateBodyReq {
	Id       uint64 `path:"id"`
	Name     string `json:"name"`
	ImageURL string `json:"image_url"`
}
type IdQueryReq {
	Id uint64 `form:"id"`
}
type ProductIdPathReq {
	ProductId uint64 `path:"product_id"`
}

type MerchantProductSaveReq {
	Name string `json:"name"`
}
type BatchProductReq {
	Action     string   `json:"action"`
	ProductIDs []uint64 `json:"product_ids"`
}
type BatchStockReq {
	Items []StockAdjustReq `json:"items"`
}
type StockAdjustReq {
	SkuID uint64 `json:"sku_id"`
}
type RecycleReq {
	ProductIDs []uint64 `json:"product_ids"`
}
type TagReq {
	Name string `json:"name"`
}
type AttrTemplateReq {
	Name string `json:"name"`
}
type CategoryReq {
	Name string `json:"name"`
}
type ArticleSaveReq {
	Title string `json:"title"`
}
type ArticleBatchAuditReq {
	IDs  []uint64 `json:"ids"`
	Pass bool     `json:"pass"`
}
type ArticleCategorySaveReq {
	Name string `json:"name"`
}
type ArticleIdListReq {
	Id uint64 `json:"id"`
}
type FavoriteAddReq {
	ProductID uint64 `json:"product_id"`
}
type FavoriteBatchRemoveReq {
	ProductIDs []uint64 `json:"product_ids"`
}
type UserArticleCreateReq {
	Title string `json:"title"`
}
type ShopRoleReq {
	Code string `json:"code"`
	Name string `json:"name"`
}
type ShopStaffReq {
	Mobile string `json:"mobile"`
	RoleID uint64 `json:"role_id"`
}
type BannerSaveReq {
	ImageURL string `json:"image_url"`
}
type EmojiSaveReq {
	Name     string `json:"name"`
	ImageURL string `json:"image_url"`
}


// Route table SSOT for catalog-service.
// Keep in sync with internal/handler/routes.go; run: scripts/check-api-routes.sh catalog-service
// group: <role>/<module> → internal/handler/<role>/<module>/
@server (
	middleware: RequestID
	group:      public/health
)
service catalogapi {
	@handler Healthz
	get /healthz returns (EmptyResp)

	@handler Readyz
	get /readyz returns (EmptyResp)

	@handler Metrics
	get /metrics
}

@server (
	middleware: RequestID
	group:      public/product
)
service catalogapi {
	@handler GetProductList
	get /api/v1/products/list (PublicProductListReq) returns (PageListResp)

	@handler GetProductDetail
	get /api/v1/products/detail (IdQueryReq) returns (ProductResp)

	@handler GetSalesRank
	get /api/v1/products/sales-rank (PageReq) returns (SalesRankResp)

	@handler Count
	get /api/v1/products/:id/favorite-count (IdPathReq) returns (CountResp)
}

@server (
	middleware: RequestID
	group:      public/category
)
service catalogapi {
	@handler GetCategoryList
	get /api/v1/product_category/list (PageReq) returns (PageListResp)

	@handler GetCategoryDetail
	get /api/v1/product_category/detail (IdQueryReq) returns (CategoryResp)
}

@server (
	middleware: RequestID
	group:      public/banner
)
service catalogapi {
	@handler ListBanners
	get /api/v1/banners (PageReq) returns (PageListResp)
}

@server (
	middleware: RequestID
	group:      public/article
)
service catalogapi {
	@handler PublicListArticles
	get /api/v1/articles/list (PublicArticleListReq) returns (PageListResp)

	@handler PublicGetArticle
	get /api/v1/articles/:id (IdPathReq) returns (ArticleResp)

	@handler ListComments
	get /api/v1/articles/:id/comments (IdPageReq) returns (PageListResp)

	@handler ListEmojis
	get /api/v1/comment-emojis (PageReq) returns (PageListResp)
}

@server (
	middleware: RequestID,GatewayIdentity
	group:      user/article
)
service catalogapi {
	@handler CreateComment
	post /api/v1/articles/:id/comments (CreateCommentBodyReq) returns (CommentResp)

	@handler Like
	post /api/v1/articles/:id/like (IdPathReq) returns (EmptyResp)

	@handler Unlike
	delete /api/v1/articles/:id/like (IdPathReq) returns (EmptyResp)

	@handler Favorite
	post /api/v1/articles/:id/favorite (IdPathReq) returns (EmptyResp)

	@handler Unfavorite
	delete /api/v1/articles/:id/favorite (IdPathReq) returns (EmptyResp)

	@handler UserArticleEngagement
	get /api/v1/articles/:id/engagement (IdPathReq) returns (EngagementResp)

	@handler ListMyFavorites
	get /api/v1/user/article-favorites (PageReq) returns (PageListResp)

	@handler ListMyLikes
	get /api/v1/user/article-likes (PageReq) returns (PageListResp)

	@handler ListMine
	get /api/v1/user/articles (PageReq) returns (PageListResp)

	@handler CreateMine
	post /api/v1/user/articles (UserArticleCreateReq) returns (ArticleResp)

	@handler DetailMine
	get /api/v1/user/articles/:id (IdPathReq) returns (ArticleResp)

	@handler UpdateMine
	put /api/v1/user/articles/:id (UserArticleUpdateBodyReq) returns (EmptyResp)

	@handler DeleteMine
	delete /api/v1/user/articles/:id (IdPathReq) returns (EmptyResp)

	@handler UploadMine
	post /api/v1/user/article-uploads returns (URLResp)
}

@server (
	middleware: RequestID,GatewayIdentity
	group:      user/favorite
)
service catalogapi {
	@handler UserAddFavorite
	post /api/v1/user/favorites (FavoriteAddReq) returns (EmptyResp)

	@handler UserRemoveFavorite
	delete /api/v1/user/favorites/:product_id (ProductIdPathReq) returns (EmptyResp)

	@handler RemoveBatch
	post /api/v1/user/favorites/batch-remove (FavoriteBatchRemoveReq) returns (EmptyResp)

	@handler UserListFavorites
	get /api/v1/user/favorites (PageReq) returns (PageListResp)

	@handler UserFavoriteStatus
	get /api/v1/products/:id/favorite (IdPathReq) returns (FavoriteStatusResp)
}

@server (
	middleware: RequestID,GatewayIdentityShop,RequireMerchantOwner
	group:      merchant/product
)
service catalogapi {
	@handler MerchantListProducts
	get /api/v1/merchant/products (MerchantProductListReq) returns (PageListResp)

	@handler MerchantCreateProduct
	post /api/v1/merchant/products (MerchantProductSaveReq) returns (ProductResp)

	@handler MerchantBatchProducts
	post /api/v1/merchant/products/batch (BatchProductReq) returns (ProductJobResp)

	@handler JobStatus
	get /api/v1/merchant/products/jobs/:id (IdPathReq) returns (ProductJobResp)

	@handler MerchantRestoreProducts
	post /api/v1/merchant/products/recycle/restore (RecycleReq) returns (EmptyResp)

	@handler MerchantPurgeProducts
	delete /api/v1/merchant/products/recycle (RecycleReq) returns (EmptyResp)

	@handler MerchantExportProducts
	get /api/v1/merchant/products/export (PageReq) returns (PageListResp)

	@handler MerchantImportProducts
	post /api/v1/merchant/products/import returns (ImportResultResp)

	@handler OpLogs
	get /api/v1/merchant/products/op-logs (OpLogsReq) returns (PageListResp)

	@handler MerchantGetProduct
	get /api/v1/merchant/products/:id (IdPathReq) returns (ProductResp)

	@handler MerchantUpdateProduct
	put /api/v1/merchant/products/:id (ProductUpdateBodyReq) returns (ProductResp)

	@handler MerchantSetProductStatus
	put /api/v1/merchant/products/:id/status (SetStatusBodyReq) returns (EmptyResp)

	@handler MerchantCopyProduct
	post /api/v1/merchant/products/:id/copy (IdPathReq) returns (ProductResp)

	@handler MerchantScheduleProduct
	post /api/v1/merchant/products/:id/schedules (ScheduleBodyReq) returns (EmptyResp)

	@handler AdjustStock
	put /api/v1/merchant/skus/:id/stock (StockAdjustBodyReq) returns (EmptyResp)

	@handler BatchStock
	post /api/v1/merchant/skus/batch-stock (BatchStockReq) returns (EmptyResp)

	@handler StockWarnings
	get /api/v1/merchant/stocks/warnings (PageReq) returns (StockWarningsResp)

	@handler MerchantUploadImage
	post /api/v1/merchant/uploads/images returns (URLResp)

	@handler CancelSchedule
	delete /api/v1/merchant/schedules/:id (IdPathReq) returns (EmptyResp)

	@handler ListTags
	get /api/v1/merchant/tags (PageReq) returns (PageListResp)

	@handler MerchantCreateTag
	post /api/v1/merchant/tags (TagReq) returns (TagResp)

	@handler MerchantUpdateTag
	put /api/v1/merchant/tags/:id (TagUpdateBodyReq) returns (TagResp)

	@handler DeleteTag
	delete /api/v1/merchant/tags/:id (IdPathReq) returns (EmptyResp)

	@handler ListAttrTemplates
	get /api/v1/merchant/attr-templates (PageReq) returns (PageListResp)

	@handler MerchantCreateAttrTemplate
	post /api/v1/merchant/attr-templates (AttrTemplateReq) returns (AttrTemplateResp)

	@handler MerchantUpdateAttrTemplate
	put /api/v1/merchant/attr-templates/:id (AttrTemplateUpdateBodyReq) returns (AttrTemplateResp)

	@handler DeleteAttrTemplate
	delete /api/v1/merchant/attr-templates/:id (IdPathReq) returns (EmptyResp)
}

@server (
	middleware: RequestID,GatewayIdentityShop,RequireMerchantOwner
	group:      merchant/shopops
)
service catalogapi {
	@handler MerchantAuthMe
	get /api/v1/merchant/auth/me returns (ShopAuthMeResp)

	@handler ListRoles
	get /api/v1/merchant/shop/roles (PageReq) returns (PageListResp)

	@handler RoleMenus
	get /api/v1/merchant/shop/roles/:id/menus (IdPathReq) returns (RoleMenuIdsResp)

	@handler MerchantCreateRole
	post /api/v1/merchant/shop/roles (ShopRoleReq) returns (ShopRoleResp)

	@handler MerchantUpdateRole
	put /api/v1/merchant/shop/roles/:id (ShopRoleUpdateBodyReq) returns (ShopRoleResp)

	@handler ListMenus
	get /api/v1/merchant/shop/menus (PageReq) returns (PageListResp)

	@handler ListStaff
	get /api/v1/merchant/shop/staff (PageReq) returns (PageListResp)

	@handler BindStaff
	post /api/v1/merchant/shop/staff (ShopStaffReq) returns (BindStaffResp)
}

@server (
	middleware: RequestID,GatewayIdentityShop,RequireMerchantOwner
	group:      merchant/article
)
service catalogapi {
	@handler MerchantListArticles
	get /api/v1/merchant/articles (MerchantArticleListReq) returns (PageListResp)

	@handler MerchantCreateArticle
	post /api/v1/merchant/articles (ArticleSaveReq) returns (ArticleResp)

	@handler MerchantGetArticle
	get /api/v1/merchant/articles/:id (IdPathReq) returns (ArticleResp)

	@handler MerchantUpdateArticle
	put /api/v1/merchant/articles/:id (ArticleUpdateBodyReq) returns (EmptyResp)

	@handler MerchantDeleteArticle
	delete /api/v1/merchant/articles/:id (IdPathReq) returns (EmptyResp)

	@handler MerchantListArticleCategories
	get /api/v1/merchant/article-categories (PageReq) returns (PageListResp)

	@handler MerchantListArticleComments
	get /api/v1/merchant/article-comments (ArticleCommentListReq) returns (PageListResp)

	@handler MerchantPatchArticleComment
	patch /api/v1/merchant/article-comments/:id (ArticleCommentPatchBodyReq) returns (EmptyResp)

	@handler MerchantDeleteArticleComment
	delete /api/v1/merchant/article-comments/:id (IdPathReq) returns (EmptyResp)

	@handler MerchantUploadArticle
	post /api/v1/merchant/article-uploads returns (URLResp)
}

@server (
	middleware: RequestID,GatewayIdentityShop,RequireMerchantOwner
	group:      merchant/notification
)
service catalogapi {
	@handler MerchantUnreadNotificationCount
	get /api/v1/merchant/notifications/unread-count returns (CountResp)

	@handler MerchantMarkAllNotificationsRead
	post /api/v1/merchant/notifications/read-all returns (EmptyResp)

	@handler MerchantListNotifications
	get /api/v1/merchant/notifications (NotificationListReq) returns (PageListResp)

	@handler MerchantMarkNotificationRead
	post /api/v1/merchant/notifications/:id/read (IdPathReq) returns (EmptyResp)
}

@server (
	middleware: RequestID,GatewayIdentity,RequirePlatformAdmin
	group:      admin/user_favorite
)
service catalogapi {
	@handler AdminListUserFavorites
	get /api/v1/admin/users/:id/favorites (IdPageReq) returns (PageListResp)
}

@server (
	middleware: RequestID,GatewayIdentity,RequirePlatformAdmin
	group:      admin/product
)
service catalogapi {
	@handler AdminListProducts
	get /api/v1/admin/products (AdminProductListReq) returns (PageListResp)

	@handler AdminOffSaleProduct
	put /api/v1/admin/products/:id/off_sale (PlatformProductRemarkBodyReq) returns (EmptyResp)

	@handler AdminDeleteProduct
	delete /api/v1/admin/products/:id (PlatformProductRemarkBodyReq) returns (EmptyResp)
}

@server (
	middleware: RequestID,GatewayIdentity,RequirePlatformAdmin
	group:      admin/category
)
service catalogapi {
	@handler AdminListCategories
	get /api/v1/admin/categories (PageReq) returns (PageListResp)

	@handler AdminCreateCategory
	post /api/v1/admin/categories (CategoryReq) returns (CategoryResp)

	@handler AdminUpdateCategory
	put /api/v1/admin/categories/:id (CategoryUpdateBodyReq) returns (EmptyResp)

	@handler AdminDeleteCategory
	delete /api/v1/admin/categories/:id (IdPathReq) returns (EmptyResp)
}

@server (
	middleware: RequestID,GatewayIdentity,RequirePlatformAdmin
	group:      admin/article
)
service catalogapi {
	@handler AdminArticleStats
	get /api/v1/admin/articles/stats returns (ArticleStatsResp)

	@handler AdminListArticleRecycle
	get /api/v1/admin/articles/recycle (AdminArticleListReq) returns (PageListResp)

	@handler AdminRestoreArticleRecycle
	post /api/v1/admin/articles/recycle/restore (ArticleIdListReq) returns (EmptyResp)

	@handler AdminPurgeArticleRecycle
	delete /api/v1/admin/articles/recycle (ArticleIdListReq) returns (EmptyResp)

	@handler AdminBatchAuditArticles
	post /api/v1/admin/articles/batch-audit (ArticleBatchAuditReq) returns (EmptyResp)

	@handler AdminListArticles
	get /api/v1/admin/articles (AdminArticleListReq) returns (PageListResp)

	@handler AdminCreateArticle
	post /api/v1/admin/articles (ArticleSaveReq) returns (ArticleResp)

	@handler AdminGetArticle
	get /api/v1/admin/articles/:id (IdPathReq) returns (ArticleResp)

	@handler AdminUpdateArticle
	put /api/v1/admin/articles/:id (ArticleUpdateBodyReq) returns (EmptyResp)

	@handler AdminSoftDeleteArticle
	delete /api/v1/admin/articles/:id (ArticleRemarkBodyReq) returns (EmptyResp)

	@handler AdminAuditArticle
	post /api/v1/admin/articles/:id/audit (ArticleAuditBodyReq) returns (EmptyResp)

	@handler AdminTopArticle
	post /api/v1/admin/articles/:id/top (ArticleTopBodyReq) returns (EmptyResp)

	@handler AdminOfflineArticle
	post /api/v1/admin/articles/:id/offline (ArticleRemarkBodyReq) returns (EmptyResp)

	@handler AdminListArticleCategories
	get /api/v1/admin/article-categories (PageReq) returns (PageListResp)

	@handler AdminCreateArticleCategory
	post /api/v1/admin/article-categories (ArticleCategorySaveReq) returns (EmptyResp)

	@handler AdminUpdateArticleCategory
	put /api/v1/admin/article-categories/:id (ArticleCategoryUpdateBodyReq) returns (EmptyResp)

	@handler AdminDeleteArticleCategory
	delete /api/v1/admin/article-categories/:id (IdPathReq) returns (EmptyResp)

	@handler AdminUploadArticle
	post /api/v1/admin/article-uploads returns (URLResp)
}

@server (
	middleware: RequestID,GatewayIdentity,RequirePlatformAdmin
	group:      admin/comment
)
service catalogapi {
	@handler AdminListArticleComments
	get /api/v1/admin/article-comments (ArticleCommentListReq) returns (PageListResp)

	@handler AdminPatchArticleComment
	patch /api/v1/admin/article-comments/:id (ArticleCommentPatchBodyReq) returns (EmptyResp)

	@handler AdminDeleteArticleComment
	delete /api/v1/admin/article-comments/:id (IdPathReq) returns (EmptyResp)

	@handler EmojiList
	get /api/v1/admin/comment-emojis (PageReq) returns (PageListResp)

	@handler EmojiCreate
	post /api/v1/admin/comment-emojis (EmojiSaveReq) returns (EmojiResp)

	@handler EmojiUpdate
	put /api/v1/admin/comment-emojis/:id (EmojiUpdateBodyReq) returns (EmptyResp)

	@handler EmojiDelete
	delete /api/v1/admin/comment-emojis/:id (IdPathReq) returns (EmptyResp)
}

@server (
	middleware: RequestID,GatewayIdentity,RequirePlatformAdmin
	group:      admin/banner
)
service catalogapi {
	@handler AdminListBanners
	get /api/v1/admin/banners (PageReq) returns (PageListResp)

	@handler CreateBanner
	post /api/v1/admin/banners (BannerSaveReq) returns (BannerResp)

	@handler UploadBanner
	post /api/v1/admin/banners/upload returns (URLResp)

	@handler GetBanner
	get /api/v1/admin/banners/:id (IdPathReq) returns (BannerResp)

	@handler UpdateBanner
	put /api/v1/admin/banners/:id (BannerUpdateBodyReq) returns (EmptyResp)

	@handler DeleteBanner
	delete /api/v1/admin/banners/:id (IdPathReq) returns (EmptyResp)
}

@server (
	middleware: RequestID,GatewayIdentity,RequirePlatformAdmin
	group:      admin/shop
)
service catalogapi {
	@handler AdminUploadShop
	post /api/v1/admin/shop-uploads returns (URLResp)
}

