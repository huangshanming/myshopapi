@server (
	middleware: RequestID,GatewayIdentity,RequirePlatformAdmin
	group:      admin/banner
)
service catalogapi {
	@handler AdminListBanners
	get /api/v1/admin/banners

	@handler CreateBanner
	post /api/v1/admin/banners

	@handler UploadBanner
	post /api/v1/admin/banners/upload

	@handler GetBanner
	get /api/v1/admin/banners/:id

	@handler UpdateBanner
	put /api/v1/admin/banners/:id

