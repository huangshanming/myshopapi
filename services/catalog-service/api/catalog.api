	@handler MerchantCreateTag
	post /api/v1/merchant/tags (JSONBody) returns (AnyResp)

	@handler MerchantUpdateTag
	put /api/v1/merchant/tags/:id (IdPathReq) returns (AnyResp)

	@handler DeleteTag
