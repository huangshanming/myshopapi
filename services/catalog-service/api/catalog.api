syntax = "v1"

// Route table SSOT for catalog-service.
// Keep in sync with internal/handler/routes.go; run: scripts/check-api-routes.sh catalog-service
@server (
	middleware: RequestID
)
service catalogapi {
	@handler Healthz
	get /healthz

	@handler Readyz
	get /readyz

	@handler Metrics
	get /metrics

	@handler GetProductList
	get /api/v1/products/list

	@handler GetProductDetail
	get /api/v1/products/detail

	@handler GetSalesRank
	get /api/v1/products/sales-rank

	@handler GetCategoryList
	get /api/v1/product_category/list

	@handler GetCategoryDetail
	get /api/v1/product_category/detail

	@handler ListBanners
	get /api/v1/banners

	@handler List
	get /api/v1/articles/list

	@handler Detail
	get /api/v1/articles/:id

	@handler ListComments
	get /api/v1/articles/:id/comments

	@handler ListEmojis
	get /api/v1/comment-emojis

	@handler Count
	get /api/v1/products/:id/favorite-count
}

@server (
	middleware: RequestID,GatewayIdentity
)
service catalogapi {
	@handler CreateComment
	post /api/v1/articles/:id/comments

	@handler Like
	post /api/v1/articles/:id/like

	@handler Unlike
	delete /api/v1/articles/:id/like

	@handler Favorite
	post /api/v1/articles/:id/favorite

	@handler Unfavorite
	delete /api/v1/articles/:id/favorite

	@handler Status
	get /api/v1/articles/:id/engagement

	@handler ListMyFavorites
	get /api/v1/user/article-favorites

	@handler ListMyLikes
	get /api/v1/user/article-likes

	@handler ListMine
	get /api/v1/user/articles

	@handler CreateMine
	post /api/v1/user/articles

	@handler DetailMine
	get /api/v1/user/articles/:id

	@handler UpdateMine
	put /api/v1/user/articles/:id

	@handler DeleteMine
	delete /api/v1/user/articles/:id

	@handler UploadMine
	post /api/v1/user/article-uploads

	@handler Add
	post /api/v1/user/favorites

	@handler Remove
	delete /api/v1/user/favorites/:product_id

	@handler RemoveBatch
	post /api/v1/user/favorites/batch-remove

	@handler List2
	get /api/v1/user/favorites

	@handler Status2
	get /api/v1/products/:id/favorite
}

@server (
	middleware: RequestID,GatewayIdentityShop,RequireMerchantOwner
)
service catalogapi {
	@handler List3
	get /api/v1/merchant/products

	@handler Create
	post /api/v1/merchant/products

	@handler Batch
	post /api/v1/merchant/products/batch

	@handler JobStatus
	get /api/v1/merchant/products/jobs/:id

	@handler RecycleRestore
	post /api/v1/merchant/products/recycle/restore

	@handler RecycleDelete
	delete /api/v1/merchant/products/recycle

	@handler Export
	get /api/v1/merchant/products/export

	@handler Import
	post /api/v1/merchant/products/import

	@handler OpLogs
	get /api/v1/merchant/products/op-logs

	@handler Detail2
	get /api/v1/merchant/products/:id

	@handler Update
	put /api/v1/merchant/products/:id

	@handler SetStatus
	put /api/v1/merchant/products/:id/status

	@handler Copy
	post /api/v1/merchant/products/:id/copy

	@handler Schedule
	post /api/v1/merchant/products/:id/schedules

	@handler AdjustStock
	put /api/v1/merchant/skus/:id/stock

	@handler BatchStock
	post /api/v1/merchant/skus/batch-stock

	@handler StockWarnings
	get /api/v1/merchant/stocks/warnings

	@handler Upload
	post /api/v1/merchant/uploads/images

	@handler CancelSchedule
	delete /api/v1/merchant/schedules/:id

	@handler ListTags
	get /api/v1/merchant/tags

	@handler SaveTag
	post /api/v1/merchant/tags

	@handler SaveTag2
	put /api/v1/merchant/tags/:id

	@handler DeleteTag
	delete /api/v1/merchant/tags/:id

	@handler ListAttrTemplates
	get /api/v1/merchant/attr-templates

	@handler SaveAttrTemplate
	post /api/v1/merchant/attr-templates

	@handler SaveAttrTemplate2
	put /api/v1/merchant/attr-templates/:id

	@handler DeleteAttrTemplate
	delete /api/v1/merchant/attr-templates/:id

	@handler AuthMe
	get /api/v1/merchant/auth/me

	@handler ListRoles
	get /api/v1/merchant/shop/roles

	@handler RoleMenus
	get /api/v1/merchant/shop/roles/:id/menus

	@handler SaveRole
	post /api/v1/merchant/shop/roles

	@handler SaveRole2
	put /api/v1/merchant/shop/roles/:id

	@handler ListMenus
	get /api/v1/merchant/shop/menus

	@handler ListStaff
	get /api/v1/merchant/shop/staff

	@handler BindStaff
	post /api/v1/merchant/shop/staff

	@handler List4
	get /api/v1/merchant/articles

	@handler Create2
	post /api/v1/merchant/articles

	@handler Detail3
	get /api/v1/merchant/articles/:id

	@handler Update2
	put /api/v1/merchant/articles/:id

	@handler Delete
	delete /api/v1/merchant/articles/:id

	@handler CategoryList
	get /api/v1/merchant/article-categories

	@handler CommentList
	get /api/v1/merchant/article-comments

	@handler CommentPatch
	patch /api/v1/merchant/article-comments/:id

	@handler CommentDelete
	delete /api/v1/merchant/article-comments/:id

	@handler Upload2
	post /api/v1/merchant/article-uploads

	@handler UnreadCount
	get /api/v1/merchant/notifications/unread-count

	@handler MarkAllRead
	post /api/v1/merchant/notifications/read-all

	@handler List5
	get /api/v1/merchant/notifications

	@handler MarkRead
	post /api/v1/merchant/notifications/:id/read
}

@server (
	middleware: RequestID,GatewayIdentity,RequirePlatformAdmin
)
service catalogapi {
	@handler AdminUserList
	get /api/v1/admin/users/:id/favorites

	@handler List6
	get /api/v1/admin/products

	@handler OffSale
	put /api/v1/admin/products/:id/off_sale

	@handler Delete2
	delete /api/v1/admin/products/:id

	@handler AdminListCategories
	get /api/v1/admin/categories

	@handler AdminCreateCategory
	post /api/v1/admin/categories

	@handler AdminUpdateCategory
	put /api/v1/admin/categories/:id

	@handler AdminDeleteCategory
	delete /api/v1/admin/categories/:id

	@handler Stats
	get /api/v1/admin/articles/stats

	@handler List7
	get /api/v1/admin/articles/recycle

	@handler RecycleRestore2
	post /api/v1/admin/articles/recycle/restore

	@handler RecycleDelete2
	delete /api/v1/admin/articles/recycle

	@handler BatchAudit
	post /api/v1/admin/articles/batch-audit

	@handler List8
	get /api/v1/admin/articles

	@handler Create3
	post /api/v1/admin/articles

	@handler Detail4
	get /api/v1/admin/articles/:id

	@handler Update3
	put /api/v1/admin/articles/:id

	@handler SoftDelete
	delete /api/v1/admin/articles/:id

	@handler Audit
	post /api/v1/admin/articles/:id/audit

	@handler Top
	post /api/v1/admin/articles/:id/top

	@handler Offline
	post /api/v1/admin/articles/:id/offline

	@handler CategoryList2
	get /api/v1/admin/article-categories

	@handler CategoryCreate
	post /api/v1/admin/article-categories

	@handler CategoryUpdate
	put /api/v1/admin/article-categories/:id

	@handler CategoryDelete
	delete /api/v1/admin/article-categories/:id

	@handler CommentList2
	get /api/v1/admin/article-comments

	@handler CommentPatch2
	patch /api/v1/admin/article-comments/:id

	@handler CommentDelete2
	delete /api/v1/admin/article-comments/:id

	@handler EmojiList
	get /api/v1/admin/comment-emojis

	@handler EmojiCreate
	post /api/v1/admin/comment-emojis

	@handler EmojiUpdate
	put /api/v1/admin/comment-emojis/:id

	@handler EmojiDelete
	delete /api/v1/admin/comment-emojis/:id

	@handler Upload3
	post /api/v1/admin/article-uploads

	@handler ListBanners2
	get /api/v1/admin/banners

	@handler CreateBanner
	post /api/v1/admin/banners

	@handler UploadBanner
	post /api/v1/admin/banners/upload

	@handler GetBanner
	get /api/v1/admin/banners/:id

	@handler UpdateBanner
	put /api/v1/admin/banners/:id

	@handler DeleteBanner
	delete /api/v1/admin/banners/:id

	@handler Upload4
	post /api/v1/admin/shop-uploads
}

