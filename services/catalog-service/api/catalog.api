	@handler AdminListArticleCategories
	get /api/v1/admin/article-categories

	@handler AdminCreateArticleCategory
	post /api/v1/admin/article-categories

	@handler AdminUpdateArticleCategory
	put /api/v1/admin/article-categories/:id

