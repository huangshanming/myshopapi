syntax = "v1"

// Route table SSOT for catalog-service.
// Keep in sync with internal/handler/routes.go; run: scripts/check-api-routes.sh catalog-service
// group: <role>/<module> → internal/handler/<role>/<module>/
@server (
	middleware: RequestID
	group:      public/health
)
service catalogapi {
	@handler Healthz
	get /healthz

	@handler Readyz
	get /readyz

	@handler Metrics
	get /metrics
}

@server (
	middleware: RequestID
	group:      public/product
)
service catalogapi {
	@handler GetProductList
	get /api/v1/products/list

	@handler GetProductDetail
	get /api/v1/products/detail

	@handler GetSalesRank
	get /api/v1/products/sales-rank

	@handler Count
	get /api/v1/products/:id/favorite-count
}

@server (
	middleware: RequestID
	group:      public/category
)
service catalogapi {
	@handler GetCategoryList
	get /api/v1/product_category/list

	@handler GetCategoryDetail
	get /api/v1/product_category/detail
}

@server (
	middleware: RequestID
	group:      public/banner
)
service catalogapi {
	@handler ListBanners
	get /api/v1/banners
}

@server (
	middleware: RequestID
	group:      public/article
)
service catalogapi {
	@handler PublicListArticles
	get /api/v1/articles/list

	@handler PublicGetArticle
	get /api/v1/articles/:id

	@handler ListComments
	get /api/v1/articles/:id/comments

	@handler ListEmojis
	get /api/v1/comment-emojis
}

@server (
	middleware: RequestID,GatewayIdentity
	group:      user/article
)
service catalogapi {
	@handler CreateComment
	post /api/v1/articles/:id/comments

	@handler Like
	post /api/v1/articles/:id/like

	@handler Unlike
	delete /api/v1/articles/:id/like

	@handler Favorite
	post /api/v1/articles/:id/favorite

	@handler Unfavorite
	delete /api/v1/articles/:id/favorite

	@handler UserArticleEngagement
	get /api/v1/articles/:id/engagement

	@handler ListMyFavorites
	get /api/v1/user/article-favorites

	@handler ListMyLikes
	get /api/v1/user/article-likes

	@handler ListMine
	get /api/v1/user/articles

	@handler CreateMine
	post /api/v1/user/articles

	@handler DetailMine
	get /api/v1/user/articles/:id

	@handler UpdateMine
	put /api/v1/user/articles/:id

	@handler DeleteMine
	delete /api/v1/user/articles/:id

	@handler UploadMine
	post /api/v1/user/article-uploads
}

@server (
	middleware: RequestID,GatewayIdentity
	group:      user/favorite
)
service catalogapi {
	@handler UserAddFavorite
	post /api/v1/user/favorites

	@handler UserRemoveFavorite
	delete /api/v1/user/favorites/:product_id

	@handler RemoveBatch
	post /api/v1/user/favorites/batch-remove

	@handler UserListFavorites
	get /api/v1/user/favorites

	@handler UserFavoriteStatus
	get /api/v1/products/:id/favorite
}

@server (
	middleware: RequestID,GatewayIdentityShop,RequireMerchantOwner
	group:      merchant/product
)
service catalogapi {
	@handler MerchantListProducts
	get /api/v1/merchant/products

	@handler MerchantCreateProduct
	post /api/v1/merchant/products

	@handler MerchantBatchProducts
	post /api/v1/merchant/products/batch

	@handler JobStatus
	get /api/v1/merchant/products/jobs/:id

	@handler MerchantRestoreProducts
	post /api/v1/merchant/products/recycle/restore

	@handler MerchantPurgeProducts
	delete /api/v1/merchant/products/recycle

	@handler MerchantExportProducts
	get /api/v1/merchant/products/export

	@handler MerchantImportProducts
	post /api/v1/merchant/products/import

	@handler OpLogs
	get /api/v1/merchant/products/op-logs

	@handler MerchantGetProduct
	get /api/v1/merchant/products/:id

	@handler MerchantUpdateProduct
	put /api/v1/merchant/products/:id

	@handler MerchantSetProductStatus
	put /api/v1/merchant/products/:id/status

	@handler MerchantCopyProduct
	post /api/v1/merchant/products/:id/copy

	@handler MerchantScheduleProduct
	post /api/v1/merchant/products/:id/schedules

	@handler AdjustStock
	put /api/v1/merchant/skus/:id/stock

	@handler BatchStock
	post /api/v1/merchant/skus/batch-stock

	@handler StockWarnings
	get /api/v1/merchant/stocks/warnings

	@handler MerchantUploadImage
	post /api/v1/merchant/uploads/images

	@handler CancelSchedule
	delete /api/v1/merchant/schedules/:id

	@handler ListTags
	get /api/v1/merchant/tags

	@handler MerchantCreateTag
	post /api/v1/merchant/tags

	@handler MerchantUpdateTag
	put /api/v1/merchant/tags/:id

	@handler DeleteTag
	delete /api/v1/merchant/tags/:id

	@handler ListAttrTemplates
	get /api/v1/merchant/attr-templates

	@handler MerchantCreateAttrTemplate
	post /api/v1/merchant/attr-templates

	@handler MerchantUpdateAttrTemplate
	put /api/v1/merchant/attr-templates/:id

	@handler DeleteAttrTemplate
	delete /api/v1/merchant/attr-templates/:id
}

@server (
	middleware: RequestID,GatewayIdentityShop,RequireMerchantOwner
	group:      merchant/shopops
)
service catalogapi {
	@handler MerchantAuthMe
	get /api/v1/merchant/auth/me

	@handler ListRoles
	get /api/v1/merchant/shop/roles

	@handler RoleMenus
	get /api/v1/merchant/shop/roles/:id/menus

	@handler MerchantCreateRole
	post /api/v1/merchant/shop/roles

	@handler MerchantUpdateRole
	put /api/v1/merchant/shop/roles/:id

	@handler ListMenus
	get /api/v1/merchant/shop/menus

	@handler ListStaff
	get /api/v1/merchant/shop/staff

	@handler BindStaff
	post /api/v1/merchant/shop/staff
}

@server (
	middleware: RequestID,GatewayIdentityShop,RequireMerchantOwner
	group:      merchant/article
)
service catalogapi {
	@handler MerchantListArticles
	get /api/v1/merchant/articles

	@handler MerchantCreateArticle
	post /api/v1/merchant/articles

	@handler MerchantGetArticle
	get /api/v1/merchant/articles/:id

	@handler MerchantUpdateArticle
	put /api/v1/merchant/articles/:id

	@handler MerchantDeleteArticle
	delete /api/v1/merchant/articles/:id

	@handler MerchantListArticleCategories
	get /api/v1/merchant/article-categories

	@handler MerchantListArticleComments
	get /api/v1/merchant/article-comments

	@handler MerchantPatchArticleComment
	patch /api/v1/merchant/article-comments/:id

	@handler MerchantDeleteArticleComment
	delete /api/v1/merchant/article-comments/:id

	@handler MerchantUploadArticle
	post /api/v1/merchant/article-uploads
}

@server (
	middleware: RequestID,GatewayIdentityShop,RequireMerchantOwner
	group:      merchant/notification
)
service catalogapi {
	@handler MerchantUnreadNotificationCount
	get /api/v1/merchant/notifications/unread-count

	@handler MerchantMarkAllNotificationsRead
	post /api/v1/merchant/notifications/read-all

	@handler MerchantListNotifications
	get /api/v1/merchant/notifications

	@handler MerchantMarkNotificationRead
	post /api/v1/merchant/notifications/:id/read
}

@server (
	middleware: RequestID,GatewayIdentity,RequirePlatformAdmin
