	@handler ListAttrTemplates
	get /api/v1/merchant/attr-templates (PageReq) returns (PageListResp)

	@handler MerchantCreateAttrTemplate
	post /api/v1/merchant/attr-templates (JSONBody) returns (AnyResp)

	@handler MerchantUpdateAttrTemplate
	put /api/v1/merchant/attr-templates/:id (IdPathReq) returns (AnyResp)

	@handler DeleteAttrTemplate
