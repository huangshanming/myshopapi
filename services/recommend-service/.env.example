MYMALL_RECO_HTTP_PORT=8888
MYMALL_RECO_MODE=dev
MYMALL_CATALOG_HTTP=http://127.0.0.1:8882

# MySQL（本地默认与其它服务一致；线上用环境变量覆盖）
MYMALL_MYSQL_HOST=127.0.0.1
MYMALL_MYSQL_PORT=3306
MYMALL_MYSQL_USERNAME=homestead
MYMALL_MYSQL_PASSWORD=secret
MYMALL_MYSQL_DBNAME=mymall
MYMALL_MYSQL_CHARSET=utf8mb4

MYMALL_REDIS_HOST=127.0.0.1
MYMALL_REDIS_PORT=6379
MYMALL_REDIS_PASSWORD=
MYMALL_REDIS_DB=0
MYMALL_RABBITMQ_URL=amqp://mymall:mymall@127.0.0.1:5672/

# Milvus standalone（docker compose 映射 19530）
MYMALL_MILVUS_HOST=127.0.0.1
MYMALL_MILVUS_PORT=19530
MYMALL_MILVUS_USER=
MYMALL_MILVUS_PASSWORD=
MYMALL_MILVUS_DB=default
MYMALL_MILVUS_ITEM_COLLECTION=reco_item_emb
MYMALL_MILVUS_EMBEDDING_DIM=64
