syntax = "v1"

// Route table SSOT for order-service.
// Keep in sync with internal/handler/routes.go; run: scripts/check-api-routes.sh order-service
@server (
	middleware: RequestID
	group:      public
)
service orderapi {
	@handler Healthz
	get /healthz

	@handler Readyz
	get /readyz

	@handler Metrics
	get /metrics

	@handler PublicListProductReviews
	get /api/v1/products/:id/reviews
}

@server (
	middleware: RequestID,GatewayIdentity
	group:      user
)
service orderapi {
	@handler UserCreateOrder
	post /api/v1/orders

	@handler CouponPreview
	post /api/v1/orders/coupon-preview

	@handler StatusCounts
	get /api/v1/orders/status-counts

	@handler UserAfterSales
	get /api/v1/orders/after-sales

	@handler UserListOrders
	get /api/v1/orders

	@handler UserGetOrder
	get /api/v1/orders/:id

	@handler Cancel
	put /api/v1/orders/:id/cancel

	@handler ConfirmReceive
	put /api/v1/orders/:id/confirm-receive

	@handler CreateAfterSale
	post /api/v1/orders/:id/after-sales

	@handler Eligible
	get /api/v1/orders/:id/review-eligible

	@handler UserCreateReview
	post /api/v1/orders/:id/reviews

	@handler GetByOrder
	get /api/v1/orders/:id/review

	@handler UserUploadReview
	post /api/v1/user/review-uploads
}

@server (
	middleware: RequestID,GatewayIdentityShop,RequireMerchantOwner
	group:      merchant
)
service orderapi {
	@handler MerchantListReviews
	get /api/v1/merchant/reviews

	@handler MerchantReply
	put /api/v1/merchant/reviews/:id/reply

	@handler MerchantDelete
	delete /api/v1/merchant/reviews/:id

	@handler MerchantListOrders
	get /api/v1/merchant/orders

	@handler MerchantDetail
	get /api/v1/merchant/orders/:id

	@handler MerchantShip
	put /api/v1/merchant/orders/:id/ship

	@handler MerchantComplete
	put /api/v1/merchant/orders/:id/complete

	@handler MerchantRemark
	put /api/v1/merchant/orders/:id/remark

	@handler MerchantAfterSales
	get /api/v1/merchant/after-sales

	@handler MerchantHandleAfterSale
	put /api/v1/merchant/after-sales/:id/handle
}

@server (
	middleware: RequestID,GatewayIdentity,RequirePlatformOrMerchant
	group:      shared
)
service orderapi {
	@handler LogisticsOptions
	get /api/v1/logistics/options
}

@server (
	middleware: RequestID,GatewayIdentity,RequirePlatformAdmin
	group:      admin
)
service orderapi {
	@handler AdminListReviews
	get /api/v1/admin/reviews

	@handler AdminDelete
	delete /api/v1/admin/reviews/:id

	@handler AdminListOrders
	get /api/v1/admin/orders

	@handler AdminDetail
	get /api/v1/admin/orders/:id

	@handler AdminShip
	put /api/v1/admin/orders/:id/ship

	@handler AdminComplete
	put /api/v1/admin/orders/:id/complete

	@handler AdminRemark
	put /api/v1/admin/orders/:id/remark

	@handler AdminAfterSales
	get /api/v1/admin/after-sales

	@handler AdminHandleAfterSale
	put /api/v1/admin/after-sales/:id/handle

	@handler AdminListLogistics
	get /api/v1/admin/logistics

	@handler AdminCreateLogistics
	post /api/v1/admin/logistics

	@handler AdminUpdateLogistics
	put /api/v1/admin/logistics/:id

	@handler UpdateStatus
	put /api/v1/admin/logistics/:id/status

	@handler AdminDeleteLogistics
	delete /api/v1/admin/logistics/:id
}

