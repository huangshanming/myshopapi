syntax = "v1"

type PageReq {
	Page     int `form:"page,default=1"`
	PageSize int `form:"page_size,default=10"`
}

type IdPathReq {
	Id uint64 `path:"id"`
}

type FilePathReq {
	File string `path:"file"`
}

type CodePathReq {
	Code string `path:"code"`
}

type EmptyResp {}

type PageListResp {
	Total int64       `json:"total"`
	List  interface{} `json:"list"`
}

type AnyResp {
	Data interface{} `json:"data,optional"`
}

type JSONBody {}

// Route table SSOT for order-service.
// group: <role>/<module> → internal/handler/<role>/<module>/
// Keep in sync with internal/handler/routes.go; run: scripts/check-api-routes.sh order-service
@server (
	middleware: RequestID
	group:      public/health
)
service orderapi {
	@handler Healthz
	get /healthz returns (EmptyResp)

	@handler Readyz
	get /readyz returns (EmptyResp)

	@handler Metrics
	get /metrics
}

@server (
	middleware: RequestID
	group:      public/review
)
service orderapi {
	@handler PublicListProductReviews
	get /api/v1/products/:id/reviews (IdPathReq) returns (PageListResp)
}

@server (
	middleware: RequestID,GatewayIdentity
	group:      user/order
)
service orderapi {
	@handler UserCreateOrder
	post /api/v1/orders (JSONBody) returns (AnyResp)

	@handler CouponPreview
	post /api/v1/orders/coupon-preview (JSONBody) returns (AnyResp)

	@handler StatusCounts
	get /api/v1/orders/status-counts returns (AnyResp)

	@handler UserAfterSales
	get /api/v1/orders/after-sales returns (AnyResp)

	@handler UserListOrders
	get /api/v1/orders (PageReq) returns (PageListResp)

	@handler UserGetOrder
	get /api/v1/orders/:id (IdPathReq) returns (AnyResp)

	@handler Cancel
	put /api/v1/orders/:id/cancel (IdPathReq) returns (AnyResp)

	@handler ConfirmReceive
	put /api/v1/orders/:id/confirm-receive (IdPathReq) returns (AnyResp)

	@handler CreateAfterSale
	post /api/v1/orders/:id/after-sales (IdPathReq) returns (AnyResp)
}

@server (
	middleware: RequestID,GatewayIdentity
	group:      user/review
)
service orderapi {
	@handler Eligible
	get /api/v1/orders/:id/review-eligible (IdPathReq) returns (AnyResp)

	@handler UserCreateReview
	post /api/v1/orders/:id/reviews (IdPathReq) returns (AnyResp)

	@handler GetByOrder
	get /api/v1/orders/:id/review (IdPathReq) returns (AnyResp)

	@handler UserUploadReview
	post /api/v1/user/review-uploads (JSONBody) returns (AnyResp)
}

@server (
	middleware: RequestID,GatewayIdentityShop,RequireMerchantOwner
	group:      merchant/review
)
service orderapi {
	@handler MerchantListReviews
	get /api/v1/merchant/reviews (PageReq) returns (PageListResp)

	@handler MerchantReply
	put /api/v1/merchant/reviews/:id/reply (IdPathReq) returns (AnyResp)

	@handler MerchantDelete
	delete /api/v1/merchant/reviews/:id (IdPathReq) returns (AnyResp)
}

@server (
	middleware: RequestID,GatewayIdentityShop,RequireMerchantOwner
	group:      merchant/order
)
service orderapi {
	@handler MerchantListOrders
	get /api/v1/merchant/orders (PageReq) returns (PageListResp)

	@handler MerchantDetail
	get /api/v1/merchant/orders/:id (IdPathReq) returns (AnyResp)

	@handler MerchantShip
	put /api/v1/merchant/orders/:id/ship (IdPathReq) returns (AnyResp)

	@handler MerchantComplete
	put /api/v1/merchant/orders/:id/complete (IdPathReq) returns (AnyResp)

	@handler MerchantRemark
	put /api/v1/merchant/orders/:id/remark (IdPathReq) returns (AnyResp)

	@handler MerchantAfterSales
	get /api/v1/merchant/after-sales returns (AnyResp)

	@handler MerchantHandleAfterSale
	put /api/v1/merchant/after-sales/:id/handle (IdPathReq) returns (AnyResp)
}

@server (
	middleware: RequestID,GatewayIdentity,RequirePlatformOrMerchant
	group:      shared/logistics
)
service orderapi {
	@handler LogisticsOptions
	get /api/v1/logistics/options returns (AnyResp)
}

@server (
	middleware: RequestID,GatewayIdentity,RequirePlatformAdmin
	group:      admin/review
)
service orderapi {
	@handler AdminListReviews
	get /api/v1/admin/reviews (PageReq) returns (PageListResp)

	@handler AdminDelete
	delete /api/v1/admin/reviews/:id (IdPathReq) returns (AnyResp)
}

@server (
	middleware: RequestID,GatewayIdentity,RequirePlatformAdmin
	group:      admin/order
)
service orderapi {
	@handler AdminListOrders
	get /api/v1/admin/orders (PageReq) returns (PageListResp)

	@handler AdminDetail
	get /api/v1/admin/orders/:id (IdPathReq) returns (AnyResp)

	@handler AdminShip
	put /api/v1/admin/orders/:id/ship (IdPathReq) returns (AnyResp)

	@handler AdminComplete
	put /api/v1/admin/orders/:id/complete (IdPathReq) returns (AnyResp)

	@handler AdminRemark
	put /api/v1/admin/orders/:id/remark (IdPathReq) returns (AnyResp)

	@handler AdminAfterSales
	get /api/v1/admin/after-sales returns (AnyResp)

	@handler AdminHandleAfterSale
	put /api/v1/admin/after-sales/:id/handle (IdPathReq) returns (AnyResp)
}

@server (
	middleware: RequestID,GatewayIdentity,RequirePlatformAdmin
	group:      admin/logistics
)
service orderapi {
	@handler AdminListLogistics
	get /api/v1/admin/logistics (PageReq) returns (PageListResp)

	@handler AdminCreateLogistics
	post /api/v1/admin/logistics (JSONBody) returns (AnyResp)

	@handler AdminUpdateLogistics
	put /api/v1/admin/logistics/:id (IdPathReq) returns (AnyResp)

	@handler UpdateStatus
	put /api/v1/admin/logistics/:id/status (IdPathReq) returns (AnyResp)

	@handler AdminDeleteLogistics
	delete /api/v1/admin/logistics/:id (IdPathReq) returns (AnyResp)
}

