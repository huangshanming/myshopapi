syntax = "v1"

type PageReq {
	Page     int    `form:"page,default=1"`
	PageSize int    `form:"page_size,default=10"`
	Status   string `form:"status,default=''"`
}

type IdPathReq {
	Id uint64 `path:"id"`
}

type FilePathReq {
	File string `path:"file"`
}

type CodePathReq {
	Code string `path:"code"`
}

type EmptyResp {}

type OrderDetailResp {
	Order      interface{} `json:"order"`
	AfterSales interface{} `json:"after_sales"`
}

type ListResp {
	List interface{} `json:"list"`
}

type ReviewEligibleResp {
	Eligible bool   `json:"eligible"`
	Reviewed bool   `json:"reviewed"`
	Status   string `json:"status"`
	OrderId  uint64 `json:"order_id"`
}

type CouponPreviewResp {
	GoodsAmount      float64     `json:"goods_amount"`
	DiscountAmount   float64     `json:"discount_amount"`
	PayAmount        float64     `json:"pay_amount"`
	BestUserCouponID uint64      `json:"best_user_coupon_id"`
	Available        interface{} `json:"available"`
	Unavailable      interface{} `json:"unavailable"`
}

type URLResp {
	Url string `json:"url"`
}

type PageListResp {
	Total int64       `json:"total"`
	List  interface{} `json:"list"`
}

type AnyResp {
	Data interface{} `json:"data,optional"`
}

type DataResp {
	Data interface{} `json:"data,optional"`
}

type LogisticsCompanyResp {
	Data interface{} `json:"data,optional"`
}

type ReviewResp {
	Data interface{} `json:"data,optional"`
}

type AfterSaleResp {
	Data interface{} `json:"data,optional"`
}

type OrderResp {
	Data interface{} `json:"data,optional"`
}

type CreateOrderItem {
	ProductID      uint64 `json:"product_id"`
	SkuID          uint64 `json:"sku_id"`
	SkuSnapshot    string `json:"sku_snapshot,optional"`
	Quantity       int    `json:"quantity"`
	SeckillEntryID uint64 `json:"seckill_entry_id,optional"`
}

type CreateOrderReq {
	AddressID    uint64            `json:"address_id"`
	Items        []CreateOrderItem `json:"items"`
	UserCouponID uint64            `json:"user_coupon_id,optional"`
}

type CouponPreviewReq {
	Items        []CreateOrderItem `json:"items"`
	UserCouponID uint64            `json:"user_coupon_id,optional"`
}

type OrderStatusCountsResp {
	Counts map[string]int64 `json:"counts"`
}

type ShipBodyReq {
	Id          uint64 `path:"id"`
	ShipCompany string `json:"ship_company"`
	ShipNo      string `json:"ship_no"`
}

type RemarkBodyReq {
	Id     uint64 `path:"id"`
	Remark string `json:"remark"`
}

type CreateAfterSaleBodyReq {
	Id     uint64  `path:"id"`
	Type   string  `json:"type"`
	Reason string  `json:"reason"`
	Amount float64 `json:"amount"`
}

type HandleAfterSaleBodyReq {
	Id          uint64 `path:"id"`
	Action      string `json:"action"`
	AdminRemark string `json:"admin_remark,optional"`
}

type LogisticsSaveBodyReq {
	Name   string `json:"name"`
	Code   string `json:"code"`
	Sort   int    `json:"sort,optional"`
	Status int    `json:"status,optional"`
}

type CreateReviewBodyReq {
	Id          uint64   `path:"id"`
	Rating      int8     `json:"rating"`
	Content     string   `json:"content,optional"`
	IsAnonymous bool     `json:"is_anonymous,optional"`
	OrderItemID uint64   `json:"order_item_id,optional"`
	Images      []string `json:"images,optional"`
}

type ReviewReplyBodyReq {
	Id    uint64 `path:"id"`
	Reply string `json:"reply"`
}

type LogisticsUpdateBodyReq {
	Id     uint64 `path:"id"`
	Name   string `json:"name"`
	Code   string `json:"code"`
	Sort   int    `json:"sort,optional"`
	Status int    `json:"status,optional"`
}

type LogisticsStatusBodyReq {
	Id     uint64 `path:"id"`
	Status int8   `json:"status"`
}

// Route table SSOT for order-service.
// group: <role>/<module> → internal/handler/<role>/<module>/
// Keep in sync with internal/handler/routes.go; run: scripts/check-api-routes.sh order-service
@server (
	middleware: RequestID
	group:      public/health
)
service orderapi {
	@handler Healthz
	get /healthz returns (EmptyResp)

	@handler Readyz
	get /readyz returns (EmptyResp)

	@handler Metrics
	get /metrics
}

@server (
	middleware: RequestID
	group:      public/review
)
service orderapi {
	@handler PublicListProductReviews
	get /api/v1/products/:id/reviews (IdPathReq) returns (PageListResp)
}

@server (
	middleware: RequestID,GatewayIdentity
	group:      user/order
)
service orderapi {
	@handler UserCreateOrder
	post /api/v1/orders (CreateOrderReq) returns (OrderResp)

	@handler CouponPreview
	post /api/v1/orders/coupon-preview (CouponPreviewReq) returns (CouponPreviewResp)

	@handler StatusCounts
	get /api/v1/orders/status-counts returns (OrderStatusCountsResp)

	@handler UserAfterSales
	get /api/v1/orders/after-sales (PageReq) returns (PageListResp)

	@handler UserListOrders
	get /api/v1/orders (PageReq) returns (PageListResp)

	@handler UserGetOrder
	get /api/v1/orders/:id (IdPathReq) returns (OrderResp)

	@handler Cancel
	put /api/v1/orders/:id/cancel (IdPathReq) returns (EmptyResp)

	@handler ConfirmReceive
	put /api/v1/orders/:id/confirm-receive (IdPathReq) returns (EmptyResp)

	@handler CreateAfterSale
	post /api/v1/orders/:id/after-sales (CreateAfterSaleBodyReq) returns (AfterSaleResp)
}

@server (
	middleware: RequestID,GatewayIdentity
	group:      user/review
)
service orderapi {
	@handler Eligible
	get /api/v1/orders/:id/review-eligible (IdPathReq) returns (ReviewEligibleResp)

	@handler UserCreateReview
	post /api/v1/orders/:id/reviews (CreateReviewBodyReq) returns (ReviewResp)

	@handler GetByOrder
	get /api/v1/orders/:id/review (IdPathReq) returns (ReviewResp)

	@handler UserUploadReview
	post /api/v1/user/review-uploads returns (URLResp)
}

@server (
	middleware: RequestID,GatewayIdentityShop,RequireMerchantOwner
	group:      merchant/review
)
service orderapi {
	@handler MerchantListReviews
	get /api/v1/merchant/reviews (PageReq) returns (PageListResp)

	@handler MerchantReply
	put /api/v1/merchant/reviews/:id/reply (ReviewReplyBodyReq) returns (EmptyResp)

	@handler MerchantDelete
	delete /api/v1/merchant/reviews/:id (IdPathReq) returns (EmptyResp)
}

@server (
	middleware: RequestID,GatewayIdentityShop,RequireMerchantOwner
	group:      merchant/order
)
service orderapi {
	@handler MerchantListOrders
	get /api/v1/merchant/orders (PageReq) returns (PageListResp)

	@handler MerchantDetail
	get /api/v1/merchant/orders/:id (IdPathReq) returns (OrderDetailResp)

	@handler MerchantShip
	put /api/v1/merchant/orders/:id/ship (ShipBodyReq) returns (EmptyResp)

	@handler MerchantComplete
	put /api/v1/merchant/orders/:id/complete (IdPathReq) returns (EmptyResp)

	@handler MerchantRemark
	put /api/v1/merchant/orders/:id/remark (RemarkBodyReq) returns (EmptyResp)

	@handler MerchantAfterSales
	get /api/v1/merchant/after-sales (PageReq) returns (PageListResp)

	@handler MerchantHandleAfterSale
	put /api/v1/merchant/after-sales/:id/handle (HandleAfterSaleBodyReq) returns (EmptyResp)
}

@server (
	middleware: RequestID,GatewayIdentity,RequirePlatformOrMerchant
	group:      shared/logistics
)
service orderapi {
	@handler LogisticsOptions
	get /api/v1/logistics/options returns (ListResp)
}

@server (
	middleware: RequestID,GatewayIdentity,RequirePlatformAdmin
	group:      admin/review
)
service orderapi {
	@handler AdminListReviews
	get /api/v1/admin/reviews (PageReq) returns (PageListResp)

	@handler AdminDelete
	delete /api/v1/admin/reviews/:id (IdPathReq) returns (EmptyResp)
}

@server (
	middleware: RequestID,GatewayIdentity,RequirePlatformAdmin
	group:      admin/order
)
service orderapi {
	@handler AdminListOrders
	get /api/v1/admin/orders (PageReq) returns (PageListResp)

	@handler AdminDetail
	get /api/v1/admin/orders/:id (IdPathReq) returns (OrderDetailResp)

	@handler AdminShip
	put /api/v1/admin/orders/:id/ship (ShipBodyReq) returns (EmptyResp)

	@handler AdminComplete
	put /api/v1/admin/orders/:id/complete (IdPathReq) returns (EmptyResp)

	@handler AdminRemark
	put /api/v1/admin/orders/:id/remark (RemarkBodyReq) returns (EmptyResp)

	@handler AdminAfterSales
	get /api/v1/admin/after-sales (PageReq) returns (PageListResp)

	@handler AdminHandleAfterSale
	put /api/v1/admin/after-sales/:id/handle (HandleAfterSaleBodyReq) returns (EmptyResp)
}

@server (
	middleware: RequestID,GatewayIdentity,RequirePlatformAdmin
	group:      admin/logistics
)
service orderapi {
	@handler AdminListLogistics
	get /api/v1/admin/logistics (PageReq) returns (PageListResp)

	@handler AdminCreateLogistics
	post /api/v1/admin/logistics (LogisticsSaveBodyReq) returns (LogisticsCompanyResp)

	@handler AdminUpdateLogistics
	put /api/v1/admin/logistics/:id (LogisticsUpdateBodyReq) returns (EmptyResp)

	@handler UpdateStatus
	put /api/v1/admin/logistics/:id/status (LogisticsStatusBodyReq) returns (EmptyResp)

	@handler AdminDeleteLogistics
	delete /api/v1/admin/logistics/:id (IdPathReq) returns (EmptyResp)
}

