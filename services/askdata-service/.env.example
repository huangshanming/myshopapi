# askdata-service（电商问数）
MYMALL_ASKDATA_HTTP_PORT=8889
MYMALL_ASKDATA_MODE=dev

# Upstream Go services (local)
MYMALL_USER_HTTP=http://127.0.0.1:8881
MYMALL_CATALOG_HTTP=http://127.0.0.1:8882
MYMALL_ORDER_HTTP=http://127.0.0.1:8883
MYMALL_MERCHANT_HTTP=http://127.0.0.1:8884

# 电商问数基建（见 deploy/local/docker-compose.yaml）
MYMALL_MYSQL_HOST=127.0.0.1
MYMALL_MYSQL_PORT=3306
MYMALL_MYSQL_USERNAME=homestead
MYMALL_MYSQL_PASSWORD=secret
MYMALL_MYSQL_DBNAME=mymall
MYMALL_ELASTICSEARCH_URL=http://127.0.0.1:9200
MYMALL_QDRANT_URL=http://127.0.0.1:6333
MYMALL_EMBEDDING_URL=http://127.0.0.1:8082

