syntax = "v1"

// Route table SSOT for user-service.
// Keep in sync with internal/handler/routes.go; run: scripts/check-api-routes.sh user-service

@server (
	middleware: RequestID
)
service userapi {
	@handler Healthz
	get /healthz

	@handler ReadyHandler
	get /readyz

	@handler Handler
	get /metrics

	@handler Login
	post /api/v1/user/login

	@handler Register
	post /api/v1/user/register

	@handler Freeze
	post /api/v1/user/wallet/freeze

	@handler Unfreeze
	post /api/v1/user/wallet/unfreeze

	@handler Settle
	post /api/v1/user/wallet/settle

	@handler InternalGet
	get /api/v1/user/addresses/internal

	@handler InternalCreateNotification
	post /api/v1/internal/notifications

	@handler InternalEvent
	post /api/v1/internal/tasks/events

	@handler InternalDeductPoints
	post /api/v1/internal/points/deduct

	@handler InternalRefundPoints
	post /api/v1/internal/points/refund

	@handler List
	get /api/v1/regions

	@handler Tree
	get /api/v1/regions/tree

}

@server (
	middleware: RequestID,UserFlexibleAuth
)
service userapi {
	@handler V1UserProfile
	get /api/v1/user/profile

	@handler UserGetWallet
	get /api/v1/user/wallet

	@handler UserWalletLogs
	get /api/v1/user/wallet/logs

	@handler List2
	get /api/v1/user/addresses

	@handler Create
	post /api/v1/user/addresses

	@handler Update
	put /api/v1/user/addresses/:id

	@handler Delete
	delete /api/v1/user/addresses/:id

	@handler SetDefault
	put /api/v1/user/addresses/:id/default

	@handler ListNotifications
	get /api/v1/user/notifications

	@handler UnreadNotificationCount
	get /api/v1/user/notifications/unread-count

	@handler MarkNotificationRead
	post /api/v1/user/notifications/:id/read

	@handler MarkAllNotificationsRead
	post /api/v1/user/notifications/read-all

	@handler UserPoints
	get /api/v1/user/points

	@handler UserPointLogs
	get /api/v1/user/points/logs

	@handler UserListTasks
	get /api/v1/user/tasks

	@handler UserCheckin
	post /api/v1/user/tasks/checkin

	@handler UserClaim
	post /api/v1/user/tasks/:code/claim

	@handler UserReportEvent
	post /api/v1/user/tasks/events

}

@server (
	middleware: RequestID,GatewayIdentity,RequirePlatformAdmin
)
service userapi {
	@handler AuthMe
	get /api/v1/admin/auth/me

	@handler MenuTree
	get /api/v1/admin/menus

	@handler CreateMenu
	post /api/v1/admin/menus

	@handler UpdateMenu
	put /api/v1/admin/menus/:id

	@handler DeleteMenu
	delete /api/v1/admin/menus/:id

	@handler ListRoles
	get /api/v1/admin/roles

	@handler CreateRole
	post /api/v1/admin/roles

	@handler UpdateRole
	put /api/v1/admin/roles/:id

	@handler DeleteRole
	delete /api/v1/admin/roles/:id

	@handler GetRoleMenus
	get /api/v1/admin/roles/:id/menus

	@handler AssignRoleMenus
	put /api/v1/admin/roles/:id/menus

	@handler ListUsers
	get /api/v1/admin/users

	@handler GetUser
	get /api/v1/admin/users/:id

	@handler UpdateUser
	put /api/v1/admin/users/:id

	@handler SetUserStatus
	put /api/v1/admin/users/:id/status

	@handler ResetUserPassword
	put /api/v1/admin/users/:id/password

	@handler GenerateUserToken
	post /api/v1/admin/users/:id/token

	@handler AdminGetWallet
	get /api/v1/admin/users/:id/wallet

	@handler AdminAdjustWallet
	post /api/v1/admin/users/:id/wallet/adjust

	@handler AdminWalletLogs
	get /api/v1/admin/users/:id/wallet/logs

	@handler AdminList
	get /api/v1/admin/users/:id/addresses

	@handler ListAdmins
	get /api/v1/admin/admins

	@handler CreateAdmin
	post /api/v1/admin/admins

	@handler GetAdminRoles
	get /api/v1/admin/admins/:id/roles

	@handler AssignAdminRoles
	put /api/v1/admin/admins/:id/roles

	@handler ResetAdminPassword
	put /api/v1/admin/admins/:id/password

	@handler ListConfigs
	get /api/v1/admin/configs

	@handler SaveConfigs
	put /api/v1/admin/configs

	@handler AdminSendNotification
	post /api/v1/admin/notifications/send

	@handler AdminListNotificationSends
	get /api/v1/admin/notifications/sends

	@handler AdminListNotificationRecipients
	get /api/v1/admin/notifications/sends/:id/recipients

	@handler AdminList2
	get /api/v1/admin/tasks

	@handler AdminUpdate
	put /api/v1/admin/tasks/:id

}
