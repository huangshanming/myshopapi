syntax = "v1"

// ---- shared DTOs (goctl types) ----
type PageReq {
	Page     int `form:"page,default=1"`
	PageSize int `form:"page_size,default=10"`
}

type IdPathReq {
	Id uint64 `path:"id"`
}

type CodePathReq {
	Code string `path:"code"`
}

type FilePathReq {
	File string `path:"file"`
}

type EmptyResp {}

type PageListResp {
	Total int64       `json:"total"`
	List  interface{} `json:"list"`
}

type CountResp {
	Count int64 `json:"count"`
}

type URLResp {
	Url string `json:"url"`
}

type TokenResp {
	Token string `json:"token"`
}

type UserTokenResp {
	Token string `json:"token"`
	UserId uint64 `json:"user_id"`
	Mobile string `json:"mobile"`
	Nickname string `json:"nickname"`
	Role string `json:"role,optional"`
	ShopId uint64 `json:"shop_id,optional"`
	ExpireHours int `json:"expire_hours,optional"`
}


type IdListResp {
	Ids []uint64 `json:"ids"`
}

type TreeResp {
	Tree interface{} `json:"tree"`
}

type NotificationRecipientsResp {
	Batch interface{} `json:"batch"`
	List  interface{} `json:"list"`
	Total int64 `json:"total"`
}


type PointsResp {
	Points int64 `json:"points"`
}

type LoginReq {
	Mobile   string `json:"mobile"`
	Password string `json:"password"`
	ShopID   uint64 `json:"shop_id,optional"`
}

type LoginResp {
	Token string      `json:"token"`
	User  interface{} `json:"user"`
}

type RegisterReq {
	Mobile   string `json:"mobile"`
	Password string `json:"password"`
}

type AddressReq {
	ReceiverName  string `json:"receiver_name"`
	ReceiverPhone string `json:"receiver_phone"`
	Province      string `json:"province"`
	City          string `json:"city"`
	District      string `json:"district"`
	Detail        string `json:"detail"`
	ProvinceCode  string `json:"province_code"`
	CityCode      string `json:"city_code"`
	DistrictCode  string `json:"district_code"`
	IsDefault     int    `json:"is_default,optional"`
}

type AddressUpdateReq {
	Id            uint64 `path:"id"`
	ReceiverName  string `json:"receiver_name,optional"`
	ReceiverPhone string `json:"receiver_phone,optional"`
	Province      string `json:"province,optional"`
	City          string `json:"city,optional"`
	District      string `json:"district,optional"`
	Detail        string `json:"detail,optional"`
	ProvinceCode  string `json:"province_code,optional"`
	CityCode      string `json:"city_code,optional"`
	DistrictCode  string `json:"district_code,optional"`
	IsDefault     int    `json:"is_default,optional"`
}

type WalletOrderOpReq {
	UserID  uint64  `json:"user_id"`
	Amount  float64 `json:"amount"`
	OrderID uint64  `json:"order_id"`
	OrderNo string  `json:"order_no"`
}

type WalletAdjustReq {
	Id     uint64  `path:"id"`
	Field  string  `json:"field"`
	Amount float64 `json:"amount"`
	Remark string  `json:"remark,optional"`
}

type InternalAddressReq {
	Id     uint64 `form:"id"`
	UserID uint64 `form:"user_id"`
}

type MenuReq {
	ParentID  uint64 `json:"parent_id,optional"`
	Name      string `json:"name"`
	Type      string `json:"type"`
	Path      string `json:"path,optional"`
	Component string `json:"component,optional"`
	Icon      string `json:"icon,optional"`
	Perms     string `json:"perms,optional"`
	Sort      int    `json:"sort,optional"`
	Visible   int    `json:"visible,optional"`
	Status    int    `json:"status,optional"`
}

type MenuUpdateReq {
	Id        uint64 `path:"id"`
	ParentID  uint64 `json:"parent_id,optional"`
	Name      string `json:"name,optional"`
	Type      string `json:"type,optional"`
	Path      string `json:"path,optional"`
	Component string `json:"component,optional"`
	Icon      string `json:"icon,optional"`
	Perms     string `json:"perms,optional"`
	Sort      int    `json:"sort,optional"`
	Visible   int    `json:"visible,optional"`
	Status    int    `json:"status,optional"`
}

type RoleReq {
	Code   string `json:"code"`
	Name   string `json:"name"`
	Status int    `json:"status,optional"`
	Remark string `json:"remark,optional"`
}

type RoleUpdateReq {
	Id     uint64 `path:"id"`
	Code   string `json:"code,optional"`
	Name   string `json:"name,optional"`
	Status int    `json:"status,optional"`
	Remark string `json:"remark,optional"`
}

type RoleMenusReq {
	Id      uint64   `path:"id"`
	MenuIDs []uint64 `json:"menu_ids"`
}

type UserStatusReq {
	Id     uint64 `path:"id"`
	Status int    `json:"status"`
}

type UserUpdateReq {
	Id       uint64 `path:"id"`
	Nickname string `json:"nickname,optional"`
	Avatar   string `json:"avatar,optional"`
	Gender   int    `json:"gender,optional"`
	Mobile   string `json:"mobile,optional"`
}

type UserResetPwdReq {
	Id       uint64 `path:"id"`
	Password string `json:"password"`
}

type AdminCreateReq {
	Mobile   string   `json:"mobile"`
	Password string   `json:"password"`
	Nickname string   `json:"nickname,optional"`
	RoleIDs  []uint64 `json:"role_ids,optional"`
}

type AdminRolesReq {
	Id      uint64   `path:"id"`
	RoleIDs []uint64 `json:"role_ids"`
}

type AdminResetPwdReq {
	Id       uint64 `path:"id"`
	Password string `json:"password"`
}

type ConfigItemReq {
	ConfigKey   string `json:"config_key"`
	ConfigValue string `json:"config_value"`
	Remark      string `json:"remark,optional"`
}

type ConfigBatchReq {
	Items []ConfigItemReq `json:"items"`
}

type ListUsersReq {
	Mobile   string `form:"mobile,optional"`
	Page     int    `form:"page,default=1"`
	PageSize int    `form:"page_size,default=10"`
}

type ListAdminsReq {
	Page     int `form:"page,default=1"`
	PageSize int `form:"page_size,default=10"`
}

type RegionListReq {
	ParentCode string `form:"parent_code,optional"`
}

type NotifyCreateReq {
	UserID  uint64 `json:"user_id"`
	Title   string `json:"title"`
	Content string `json:"content"`
	Type    string `json:"type,optional"`
}

type AdminSendReq {
	Title   string   `json:"title"`
	Content string   `json:"content"`
	UserIDs []uint64 `json:"user_ids,optional"`
	SendAll bool     `json:"send_all,optional"`
}

type TaskEventReq {
	Event string `json:"event"`
	RefId string `json:"ref_id,optional"`
}

type PointsLedgerReq {
	UserID uint64 `json:"user_id"`
	Points int64  `json:"points"`
	Reason string `json:"reason,optional"`
	RefNo  string `json:"ref_no,optional"`
}

type UpdateTaskReq {
	Id          uint64 `path:"id"`
	Name        string `json:"name,optional"`
	Points      int64  `json:"points,optional"`
	Status      string `json:"status,optional"`
	Description string `json:"description,optional"`
}

type ExchangeReq {
	ProductID uint64 `json:"product_id"`
	AddressID uint64 `json:"address_id,optional"`
	Remark    string `json:"remark,optional"`
}

type PointsProductSaveReq {
	Name         string `json:"name"`
	CoverURL     string `json:"cover_url,optional"`
	Description  string `json:"description,optional"`
	PointsPrice  int    `json:"points_price,optional"`
	Stock        int    `json:"stock,optional"`
	PerUserLimit int    `json:"per_user_limit,optional"`
	Status       string `json:"status,optional"`
	Sort         int    `json:"sort,optional"`
}

type PointsProductUpdateReq {
	Id           uint64 `path:"id"`
	Name         string `json:"name,optional"`
	CoverURL     string `json:"cover_url,optional"`
	Description  string `json:"description,optional"`
	PointsPrice  int    `json:"points_price,optional"`
	Stock        int    `json:"stock,optional"`
	PerUserLimit int    `json:"per_user_limit,optional"`
	Status       string `json:"status,optional"`
	Sort         int    `json:"sort,optional"`
}

type PointsProductStatusReq {
	Id     uint64 `path:"id"`
	Status string `json:"status"`
}

type ListPointsProductsReq {
	Page     int    `form:"page,default=1"`
	PageSize int    `form:"page_size,default=10"`
	Status   string `form:"status,optional"`
	Keyword  string `form:"keyword,optional"`
}

type ListPointsOrdersReq {
	Page     int    `form:"page,default=1"`
	PageSize int    `form:"page_size,default=10"`
	Status   string `form:"status,optional"`
	OrderNo  string `form:"order_no,optional"`
	Keyword  string `form:"keyword,optional"`
	UserID   uint64 `form:"user_id,optional"`
}

type ShipReq {
	Id             uint64 `path:"id"`
	ExpressCompany string `json:"express_company"`
	ExpressNo      string `json:"express_no"`
}

type RemarkReq {
	Id     uint64 `path:"id"`
	Remark string `json:"remark"`
}

type AdminWalletLogsReq {
	Id       uint64 `path:"id"`
	Page     int    `form:"page,default=1"`
	PageSize int    `form:"page_size,default=10"`
}

type NotificationRecipientsReq {
	Id       uint64 `path:"id"`
	Page     int    `form:"page,default=1"`
	PageSize int    `form:"page_size,default=10"`
}

type AnyResp {
	Data interface{} `json:"data,optional"`
}

type DataResp {
	Data interface{} `json:"data,optional"`
}

type CheckinResp {
	Data interface{} `json:"data,optional"`
}

type NotificationResp {
	Data interface{} `json:"data,optional"`
}

type NotificationBatchResp {
	Data interface{} `json:"data,optional"`
}

type PointsOrderResp {
	Data interface{} `json:"data,optional"`
}

type PointsProductResp {
	Data interface{} `json:"data,optional"`
}

type TaskResp {
	Data interface{} `json:"data,optional"`
}

type RoleResp {
	Data interface{} `json:"data,optional"`
}

type MenuResp {
	Data interface{} `json:"data,optional"`
}

type AddressResp {
	Data interface{} `json:"data,optional"`
}

type WalletResp {
	Data interface{} `json:"data,optional"`
}

type UserResp {
	Data interface{} `json:"data,optional"`
}

type MenuTreeNode {
	ID        uint64          `json:"id"`
	ParentID  uint64          `json:"parent_id"`
	Name      string          `json:"name"`
	Type      string          `json:"type"`
	Path      string          `json:"path"`
	Component string          `json:"component"`
	Icon      string          `json:"icon"`
	Perms     string          `json:"perms"`
	Sort      int             `json:"sort"`
	Visible   int             `json:"visible"`
	Status    int             `json:"status"`
	Children  []*MenuTreeNode `json:"children,optional"`
}

type AuthMeResp {
	Roles    []string        `json:"roles"`
	Perms    []string        `json:"perms"`
	MenuTree []*MenuTreeNode `json:"menu_tree"`
}

@server (
	middleware: RequestID
	group:      public/health
)
service userapi {
	@handler Healthz
	get /healthz returns (EmptyResp)

	@handler Readyz
	get /readyz returns (EmptyResp)

	@handler Metrics
	get /metrics
}

@server (
	middleware: RequestID
	group:      public/auth
)
service userapi {
	@handler Login
	post /api/v1/user/login (LoginReq) returns (LoginResp)

	@handler Register
	post /api/v1/user/register (RegisterReq) returns (UserResp)
}

@server (
	middleware: RequestID
	group:      public/region
)
service userapi {
	@handler ListRegions
	get /api/v1/regions (RegionListReq) returns (PageListResp)

	@handler RegionTree
	get /api/v1/regions/tree returns (TreeResp)
}

@server (
	middleware: RequestID
	group:      internalapi/wallet
)
service userapi {
	@handler InternalFreezeWallet
	post /api/v1/user/wallet/freeze (WalletOrderOpReq) returns (EmptyResp)

	@handler InternalUnfreezeWallet
	post /api/v1/user/wallet/unfreeze (WalletOrderOpReq) returns (EmptyResp)

	@handler InternalSettleWallet
	post /api/v1/user/wallet/settle (WalletOrderOpReq) returns (EmptyResp)
}

@server (
	middleware: RequestID
	group:      internalapi/address
)
service userapi {
	@handler InternalGet
	get /api/v1/user/addresses/internal (InternalAddressReq) returns (AddressResp)
}

@server (
	middleware: RequestID
	group:      internalapi/notification
)
service userapi {
	@handler InternalCreateNotification
	post /api/v1/internal/notifications (NotifyCreateReq) returns (NotificationResp)
}

@server (
	middleware: RequestID
	group:      internalapi/task
)
service userapi {
	@handler InternalEvent
	post /api/v1/internal/tasks/events (TaskEventReq) returns (EmptyResp)
}

@server (
	middleware: RequestID
	group:      internalapi/points
)
service userapi {
	@handler InternalDeductPoints
	post /api/v1/internal/points/deduct (PointsLedgerReq) returns (PointsResp)

	@handler InternalRefundPoints
	post /api/v1/internal/points/refund (PointsLedgerReq) returns (PointsResp)
}

@server (
	middleware: RequestID,UserFlexibleAuth
	group:      user/profile
)
service userapi {
	@handler UserProfile
	get /api/v1/user/profile returns (UserResp)
}

@server (
	middleware: RequestID,UserFlexibleAuth
	group:      user/wallet
)
service userapi {
	@handler UserGetWallet
	get /api/v1/user/wallet returns (WalletResp)

	@handler UserWalletLogs
	get /api/v1/user/wallet/logs (PageReq) returns (PageListResp)
}

@server (
	middleware: RequestID,UserFlexibleAuth
	group:      user/address
)
service userapi {
	@handler UserListAddresses
	get /api/v1/user/addresses returns (PageListResp)

	@handler UserCreateAddress
	post /api/v1/user/addresses (AddressReq) returns (AddressResp)

	@handler UserUpdateAddress
	put /api/v1/user/addresses/:id (AddressUpdateReq) returns (EmptyResp)

	@handler UserDeleteAddress
	delete /api/v1/user/addresses/:id (IdPathReq) returns (EmptyResp)

	@handler SetDefault
	put /api/v1/user/addresses/:id/default (IdPathReq) returns (EmptyResp)
}

@server (
	middleware: RequestID,UserFlexibleAuth
	group:      user/notification
)
service userapi {
	@handler ListNotifications
	get /api/v1/user/notifications (PageReq) returns (PageListResp)

	@handler UnreadNotificationCount
	get /api/v1/user/notifications/unread-count returns (CountResp)

	@handler MarkNotificationRead
	post /api/v1/user/notifications/:id/read (IdPathReq) returns (EmptyResp)

	@handler MarkAllNotificationsRead
	post /api/v1/user/notifications/read-all returns (EmptyResp)
}

@server (
	middleware: RequestID,UserFlexibleAuth
	group:      user/points
)
service userapi {
	@handler UserPoints
	get /api/v1/user/points returns (PointsResp)

	@handler UserPointLogs
	get /api/v1/user/points/logs (PageReq) returns (PageListResp)
}

@server (
	middleware: RequestID,UserFlexibleAuth
	group:      user/task
)
service userapi {
	@handler UserListTasks
	get /api/v1/user/tasks returns (PageListResp)

	@handler UserCheckin
	post /api/v1/user/tasks/checkin returns (CheckinResp)

	@handler UserClaim
	post /api/v1/user/tasks/:code/claim (CodePathReq) returns (PointsResp)

	@handler UserReportEvent
	post /api/v1/user/tasks/events (TaskEventReq) returns (EmptyResp)
}

@server (
	middleware: RequestID,GatewayIdentity,RequirePlatformAdmin
	group:      admin/auth
)
service userapi {
	@handler AuthMe
	get /api/v1/admin/auth/me returns (AuthMeResp)
}

@server (
	middleware: RequestID,GatewayIdentity,RequirePlatformAdmin
	group:      admin/menu
)
service userapi {
	@handler MenuTree
	get /api/v1/admin/menus returns (TreeResp)

	@handler CreateMenu
	post /api/v1/admin/menus (MenuReq) returns (MenuResp)

	@handler UpdateMenu
	put /api/v1/admin/menus/:id (MenuUpdateReq) returns (EmptyResp)

	@handler DeleteMenu
	delete /api/v1/admin/menus/:id (IdPathReq) returns (EmptyResp)
}

@server (
	middleware: RequestID,GatewayIdentity,RequirePlatformAdmin
	group:      admin/role
)
service userapi {
	@handler ListRoles
	get /api/v1/admin/roles returns (PageListResp)

	@handler CreateRole
	post /api/v1/admin/roles (RoleReq) returns (RoleResp)

	@handler UpdateRole
	put /api/v1/admin/roles/:id (RoleUpdateReq) returns (EmptyResp)

	@handler DeleteRole
	delete /api/v1/admin/roles/:id (IdPathReq) returns (EmptyResp)

	@handler GetRoleMenus
	get /api/v1/admin/roles/:id/menus (IdPathReq) returns (IdListResp)

	@handler AssignRoleMenus
	put /api/v1/admin/roles/:id/menus (RoleMenusReq) returns (EmptyResp)
}

@server (
	middleware: RequestID,GatewayIdentity,RequirePlatformAdmin
	group:      admin/user
)
service userapi {
	@handler ListUsers
	get /api/v1/admin/users (ListUsersReq) returns (PageListResp)

	@handler GetUser
	get /api/v1/admin/users/:id (IdPathReq) returns (UserResp)

	@handler UpdateUser
	put /api/v1/admin/users/:id (UserUpdateReq) returns (EmptyResp)

	@handler SetUserStatus
	put /api/v1/admin/users/:id/status (UserStatusReq) returns (EmptyResp)

	@handler ResetUserPassword
	put /api/v1/admin/users/:id/password (UserResetPwdReq) returns (EmptyResp)

	@handler GenerateUserToken
	post /api/v1/admin/users/:id/token (IdPathReq) returns (UserTokenResp)

	@handler AdminGetWallet
	get /api/v1/admin/users/:id/wallet (IdPathReq) returns (WalletResp)

	@handler AdminAdjustWallet
	post /api/v1/admin/users/:id/wallet/adjust (WalletAdjustReq) returns (WalletResp)

	@handler AdminWalletLogs
	get /api/v1/admin/users/:id/wallet/logs (AdminWalletLogsReq) returns (PageListResp)

	@handler AdminListUserAddresses
	get /api/v1/admin/users/:id/addresses (IdPathReq) returns (PageListResp)
}

@server (
	middleware: RequestID,GatewayIdentity,RequirePlatformAdmin
	group:      admin/staff
)
service userapi {
	@handler ListAdmins
	get /api/v1/admin/admins (ListAdminsReq) returns (PageListResp)

	@handler CreateAdmin
	post /api/v1/admin/admins (AdminCreateReq) returns (UserResp)

	@handler GetAdminRoles
	get /api/v1/admin/admins/:id/roles (IdPathReq) returns (IdListResp)

	@handler AssignAdminRoles
	put /api/v1/admin/admins/:id/roles (AdminRolesReq) returns (EmptyResp)

	@handler ResetAdminPassword
	put /api/v1/admin/admins/:id/password (AdminResetPwdReq) returns (EmptyResp)
}

@server (
	middleware: RequestID,GatewayIdentity,RequirePlatformAdmin
	group:      admin/config
)
service userapi {
	@handler ListConfigs
	get /api/v1/admin/configs returns (PageListResp)

	@handler SaveConfigs
	put /api/v1/admin/configs (ConfigBatchReq) returns (EmptyResp)
}

@server (
	middleware: RequestID,GatewayIdentity,RequirePlatformAdmin
	group:      admin/notification
)
service userapi {
	@handler AdminSendNotification
	post /api/v1/admin/notifications/send (AdminSendReq) returns (NotificationBatchResp)

	@handler AdminListNotificationSends
	get /api/v1/admin/notifications/sends (PageReq) returns (PageListResp)

	@handler AdminListNotificationRecipients
	get /api/v1/admin/notifications/sends/:id/recipients (NotificationRecipientsReq) returns (NotificationRecipientsResp)
}

@server (
	middleware: RequestID,GatewayIdentity,RequirePlatformAdmin
	group:      admin/task
)
service userapi {
	@handler AdminListTasks
	get /api/v1/admin/tasks returns (PageListResp)

	@handler AdminUpdateTask
	put /api/v1/admin/tasks/:id (UpdateTaskReq) returns (TaskResp)
}

@server (
	middleware: RequestID
	group:      public/points_mall
)
service userapi {
	@handler ServePointsMallUpload
	get /uploads/points-mall/:file (FilePathReq)
}

@server (
	middleware: RequestID,GatewayIdentity
	group:      user/points_mall
)
service userapi {
	@handler Exchange
	post /api/v1/user/points-mall/exchange (ExchangeReq) returns (PointsOrderResp)

	@handler ListUserPointsOrders
	get /api/v1/user/points-mall/orders (PageReq) returns (PageListResp)

	@handler DetailUserPointsOrder
	get /api/v1/user/points-mall/orders/:id (IdPathReq) returns (PointsOrderResp)
}

@server (
	middleware: RequestID,GatewayIdentity,RequirePlatformAdmin
	group:      admin/points_mall
)
service userapi {
	@handler ListPointsProducts
	get /api/v1/admin/points-products (ListPointsProductsReq) returns (PageListResp)

	@handler CreatePointsProduct
	post /api/v1/admin/points-products (PointsProductSaveReq) returns (PointsProductResp)

	@handler UploadPointsProduct
	post /api/v1/admin/points-products/upload returns (URLResp)

	@handler DetailPointsProduct
	get /api/v1/admin/points-products/:id (IdPathReq) returns (PointsProductResp)

	@handler UpdatePointsProduct
	put /api/v1/admin/points-products/:id (PointsProductUpdateReq) returns (PointsProductResp)

	@handler SetPointsProductStatus
	put /api/v1/admin/points-products/:id/status (PointsProductStatusReq) returns (PointsProductResp)

	@handler DeletePointsProduct
	delete /api/v1/admin/points-products/:id (IdPathReq) returns (EmptyResp)

	@handler ListPointsOrders
	get /api/v1/admin/points-orders (ListPointsOrdersReq) returns (PageListResp)

	@handler DetailPointsOrder
	get /api/v1/admin/points-orders/:id (IdPathReq) returns (PointsOrderResp)

	@handler ShipPointsOrder
	post /api/v1/admin/points-orders/:id/ship (ShipReq) returns (PointsOrderResp)

	@handler CompletePointsOrder
	post /api/v1/admin/points-orders/:id/complete (IdPathReq) returns (PointsOrderResp)

	@handler CancelPointsOrder
	post /api/v1/admin/points-orders/:id/cancel (RemarkReq) returns (PointsOrderResp)

	@handler RemarkPointsOrder
	put /api/v1/admin/points-orders/:id/remark (RemarkReq) returns (PointsOrderResp)
}

