          "example": 200
        },
        "data": {},
        "msg": {
          "type": "string",
          "example": "success"
        }
      }
    },
    "dto.LoginReq": {
      "type": "object",
      "required": [
        "mobile",
        "password"
      ],
      "properties": {
        "mobile": {
          "type": "string",
          "example": "13800138000"
        },
        "password": {
          "type": "string",
          "minLength": 6,
          "example": "123456"
        }
      }
    },
    "dto.LoginResp": {
      "type": "object",
      "properties": {
        "token": {
          "type": "string",
          "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
        },
        "user": {
          "$ref": "#/definitions/dto.UserInfo"
        }
      }
    },
    "dto.RegisterReq": {
      "type": "object",
      "required": [
        "mobile",
        "password"
      ],
      "properties": {
        "mobile": {
          "type": "string",
          "example": "13800138000"
