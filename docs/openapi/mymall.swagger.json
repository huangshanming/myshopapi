{
  "swagger": "2.0",
  "info": {
    "title": "mymall 商城 API",
    "description": "宠物商城 REST API（user + catalog + order 合并文档）。\n\n统一响应 `{code, msg, data}`，code=200 表示业务成功。\n经 APISIX 网关: http://localhost:9080\n本地直连: user :8881, catalog :8882, order :8883",
    "version": "1.0.0",
    "contact": {
      "name": "mymall"
    }
  },
  "host": "localhost:9080",
  "basePath": "/",
  "paths": {
    "/api/v1/user/login": {
      "post": {
        "description": "手机号 + 密码登录，返回 JWT Token",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "tags": [
          "用户"
        ],
        "summary": "用户登录",
        "parameters": [
          {
            "description": "登录参数",
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/dto.LoginReq"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "登录成功",
            "schema": {
              "allOf": [
                {
                  "$ref": "#/definitions/apidoc.Response"
                },
                {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/definitions/dto.LoginResp"
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    "/api/v1/user/profile": {
      "get": {
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "description": "需要 JWT 鉴权",
        "produces": [
          "application/json"
        ],
        "tags": [
          "用户"
        ],
        "summary": "获取个人资料",
        "responses": {
          "200": {
            "description": "查询成功",
            "schema": {
              "allOf": [
                {
                  "$ref": "#/definitions/apidoc.Response"
                },
                {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/definitions/dto.UserProfileResp"
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    "/api/v1/user/register": {
      "post": {
        "description": "手机号注册新用户",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "tags": [
          "用户"
        ],
        "summary": "用户注册",
        "parameters": [
          {
            "description": "注册参数",
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/dto.RegisterReq"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "注册成功",
            "schema": {
              "allOf": [
                {
                  "$ref": "#/definitions/apidoc.Response"
                },
                {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/definitions/dto.UserInfo"
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    "/api/v1/product_category/detail": {
      "get": {
        "description": "根据分类 ID 查询详情",
        "produces": [
          "application/json"
        ],
        "tags": [
          "分类"
        ],
        "summary": "分类详情",
        "parameters": [
          {
            "type": "integer",
            "description": "分类 ID",
            "name": "id",
            "in": "query",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "查询成功",
            "schema": {
              "allOf": [
                {
                  "$ref": "#/definitions/apidoc.Response"
                },
                {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/definitions/dto.CategoryDetailResp"
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    "/api/v1/product_category/list": {
      "get": {
        "description": "分页查询商品分类",
        "produces": [
          "application/json"
        ],
        "tags": [
          "分类"
        ],
        "summary": "分类列表",
        "parameters": [
          {
            "type": "integer",
            "default": 1,
            "description": "页码",
            "name": "page",
            "in": "query"
          },
          {
            "type": "integer",
            "default": 10,
            "description": "每页数量",
            "name": "page_size",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "查询成功",
            "schema": {
              "allOf": [
                {
                  "$ref": "#/definitions/apidoc.Response"
                },
                {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/definitions/dto.CategoryListResp"
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    "/api/v1/products/detail": {
      "get": {
        "description": "根据商品 ID 查询详情",
        "produces": [
          "application/json"
        ],
        "tags": [
          "商品"
        ],
        "summary": "商品详情",
        "parameters": [
          {
            "type": "integer",
            "description": "商品 ID",
            "name": "id",
            "in": "query",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "查询成功",
            "schema": {
              "allOf": [
                {
                  "$ref": "#/definitions/apidoc.Response"
                },
                {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/definitions/dto.ProductDetail"
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    "/api/v1/products/list": {
      "get": {
        "description": "分页查询在售商品",
        "produces": [
          "application/json"
        ],
        "tags": [
          "商品"
        ],
        "summary": "商品列表",
        "parameters": [
          {
            "type": "integer",
            "default": 1,
            "description": "页码",
            "name": "page",
            "in": "query"
          },
          {
            "type": "integer",
            "default": 10,
            "description": "每页数量",
            "name": "page_size",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "查询成功",
            "schema": {
              "allOf": [
                {
                  "$ref": "#/definitions/apidoc.Response"
                },
                {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/definitions/dto.ProductListResp"
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    "/api/v1/orders": {
      "get": {
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "description": "分页查询当前用户订单",
        "produces": [
          "application/json"
        ],
        "tags": [
          "订单"
        ],
        "summary": "我的订单列表",
        "parameters": [
          {
            "type": "integer",
            "description": "用户 ID（网关注入）",
            "name": "X-User-Id",
            "in": "header"
          },
          {
            "type": "integer",
            "default": 1,
            "description": "页码",
            "name": "page",
            "in": "query"
          },
          {
            "type": "integer",
            "default": 10,
            "description": "每页数量",
            "name": "page_size",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "查询成功",
            "schema": {
              "allOf": [
                {
                  "$ref": "#/definitions/apidoc.Response"
                },
                {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/definitions/dto.OrderListResp"
                    }
                  }
                }
              ]
            }
          }
        }
      },
      "post": {
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "description": "需要 JWT；经 APISIX 网关时从 Authorization 注入 X-User-Id",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "tags": [
          "订单"
        ],
        "summary": "创建订单",
        "parameters": [
          {
            "type": "integer",
            "description": "用户 ID（网关注入，直连调试时必填）",
            "name": "X-User-Id",
            "in": "header"
          },
          {
            "description": "下单商品",
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/dto.CreateOrderReq"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "创建成功",
            "schema": {
              "allOf": [
                {
                  "$ref": "#/definitions/apidoc.Response"
                },
                {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/definitions/dto.OrderInfo"
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    "/api/v1/orders/{id}": {
      "get": {
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "produces": [
          "application/json"
        ],
        "tags": [
          "订单"
        ],
        "summary": "订单详情",
        "parameters": [
          {
            "type": "integer",
            "description": "用户 ID（网关注入）",
            "name": "X-User-Id",
            "in": "header"
          },
          {
            "type": "integer",
            "description": "订单 ID",
            "name": "id",
            "in": "path",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "查询成功",
            "schema": {
              "allOf": [
                {
                  "$ref": "#/definitions/apidoc.Response"
                },
                {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/definitions/dto.OrderInfo"
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    "/api/v1/orders/{id}/cancel": {
      "put": {
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "description": "pending/confirmed 状态可取消，会触发库存回滚",
        "produces": [
          "application/json"
        ],
        "tags": [
          "订单"
        ],
        "summary": "取消订单",
        "parameters": [
          {
            "type": "integer",
            "description": "用户 ID（网关注入）",
            "name": "X-User-Id",
            "in": "header"
          },
          {
            "type": "integer",
            "description": "订单 ID",
            "name": "id",
            "in": "path",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "取消成功",
            "schema": {
              "allOf": [
                {
                  "$ref": "#/definitions/apidoc.Response"
                },
                {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/definitions/apidoc.EmptyData"
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  },
  "definitions": {
