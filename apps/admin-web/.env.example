# 复制为 .env 或 .env.local 后按需修改
# Vite 只会把 VITE_ 前缀变量暴露给前端（import.meta.env）

# API 根地址
# - 留空：开发时用 vite.config.js 的 /api 代理（直连微服务）
# - 走网关：http://localhost:9080（需先 port-forward / 暴露 APISIX）
VITE_API_BASE=

# 腾讯位置服务 Key（H5 地图选点；也可只配服务端 MYMALL_TENCENT_MAP_KEY，由 /api/v1/map/config 下发）
# VITE_TENCENT_MAP_KEY=

# 可选：代理默认上游（仅 vite 服务端读取，不会打进前端包）
# VITE_API_PROXY=http://localhost:8881
